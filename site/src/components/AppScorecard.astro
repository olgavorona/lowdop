---
import { displayScore, scoreDimensions, type AppReview } from "../data/appReviews";
const { review, compact = false } = Astro.props as { review: AppReview; compact?: boolean };
---

<div class:list={["scorecard", { compact }]}>
  {scoreDimensions.map((dimension) => {
    const score = review.scores[dimension.key];
    return (
      <div class="score-row">
        <div class="score-label"><span>{dimension.label}</span>{!compact && <small>{dimension.short}</small>}</div>
        <div class="track" aria-hidden="true"><span style={`width:${score * 10}%`} /></div>
        <strong>{displayScore(score)}</strong>
      </div>
    );
  })}
</div>

<style>
  .scorecard { display: grid; gap: .85rem; }
  .score-row { display: grid; grid-template-columns: minmax(9rem, 1fr) minmax(7rem, 1.4fr) 2.5rem; gap: .8rem; align-items: center; }
  .score-label { display: grid; line-height: 1.2; }
  .score-label small { margin-top: .2rem; color: var(--muted); font-size: .75rem; }
  .track { height: 7px; overflow: hidden; border-radius: 99px; background: var(--line-faint); }
  .track span { display: block; height: 100%; border-radius: inherit; background: var(--accent); }
  strong { font-family: var(--font-mono); font-size: .8rem; text-align: right; }
  .compact .score-row { grid-template-columns: minmax(7.5rem, 1fr) minmax(5rem, 1.2fr) 2.5rem; gap: .55rem; }
  @media (max-width: 430px) { .score-row { grid-template-columns: 1fr 2.5rem; } .track { grid-column: 1 / -1; grid-row: 2; } }
</style>
