---
import { siteConfig } from "../data/site";
import { appStoreUrl } from "../lib/analytics";

const appCampaign = "website_printables";
import type { PrintableMaze, PrintablePack } from "../data/printables/fallMazes";

type Props = {
  title: string;
  supportLine: string;
  intro: string;
  mazes: PrintableMaze[];
  downloadPacks: PrintablePack[];
  colorDownloadPacks: PrintablePack[];
  themeName?: string;
  includedMazes?: string[];
};

const {
  title,
  supportLine,
  intro,
  mazes,
  downloadPacks,
  colorDownloadPacks,
  themeName = "Fall",
  includedMazes = ["Fall Leaf Maze", "Apple Maze", "Corn Maze", "Pumpkin Maze", "Acorn Maze", "Rainy Puddle Maze"]
} = Astro.props as Props;
const modalMazes = mazes.map((maze) => ({
  title: maze.title,
  preview: maze.preview,
  alt: maze.alt,
  difficulties: maze.difficulties
}));
const printableCount = mazes.length;
const themeLower = themeName.toLowerCase();
const faqItems = [
  {
    question: `Are these ${themeLower} mazes free to print?`,
    answer: `Yes. You can download and print all ${printableCount} ${themeLower} maze designs for free.`
  },
  {
    question: "What ages are these printable mazes for?",
    answer:
      "They are designed roughly for children ages 2-6. Easy is best for beginners, while Medium and Hard provide progressively more challenging paths."
  },
  {
    question: `Can I use these ${themeLower} mazes for preschool or kindergarten?`,
    answer:
      "Yes. The simpler versions work well as quiet preschool and kindergarten activities, fine-motor practice, early-finisher activities and no-prep play at home."
  },
  {
    question: `Can I print all the ${themeLower} mazes at once?`,
    answer: `Yes. Choose a difficulty and use the full-set download option to get all ${printableCount} ${themeLower} mazes together.`
  }
];
---

<article class="printables-article">
  <div class="shell printables-shell">
    <h1>{title}</h1>
    <p class="printables-support">{supportLine}</p>
    <div class="printables-lead">
      {intro.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>

  <section class="printables-maze-list" aria-label={`${themeName} maze downloads`}>
    <div class="shell printables-shell">
      <section class="printables-included" aria-labelledby="included-heading">
        <h2 id="included-heading">What's Included in These Printable {themeName} Mazes?</h2>
        <p>The free PDF set includes {printableCount} {themeLower}-themed maze puzzles in both full color and black and white:</p>
        <ul>
          {includedMazes.map((item) => <li>{item}</li>)}
        </ul>
        <p>
          Each design is available in Easy, Medium and Hard difficulty, giving
          families different challenge levels while keeping the same {themeLower} theme.
          Choose full color for a ready-to-play activity or black and white for
          lower-ink printing and extra coloring.
        </p>
      </section>

      <div class="printables-global-toolbar" aria-label="Choose preview difficulty">
        <div>
          <p class="eyebrow">Preview difficulty</p>
          <h2>Choose a Difficulty for All {printableCount} Mazes</h2>
          <p>Switch the whole printable set between Easy, Medium and Hard.</p>
        </div>
        <div class="difficulty-control global-difficulty-control">
          {mazes[0]?.difficulties.map((difficulty, index) => (
            <button
              type="button"
              class:list={["difficulty-button", index === 0 && "active"]}
              data-global-difficulty
              data-difficulty-index={index}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {difficulty.label}
            </button>
          ))}
        </div>
        <div class="format-control" aria-label="Choose printable color style">
          <button type="button" class="difficulty-button" data-format-button data-format-choice="bw" aria-pressed="false">Black &amp; white</button>
          <button type="button" class="difficulty-button active" data-format-button data-format-choice="color" aria-pressed="true">Full color</button>
        </div>
      </div>

      <section class="printables-app-cta">
        <div class="printables-app-cta-inner">
          <img src="/images/denny.png" alt="" width="160" height="160" loading="lazy" />
          <div>
            <p class="eyebrow">Denny's Maze App</p>
            <h2>Want More Mazes? Try Denny's Maze on iPad</h2>
            <p>
              These free printable mazes are for times when you want a simple
              paper activity. Denny's Maze brings the same calm, paper-like
              maze experience to iPad, with 180 mazes across three difficulty
              levels.
            </p>
            <div class="printables-actions">
              <a class="button" href={siteConfig.productPath}>Denny's Maze for iPad</a>
              <a class="button secondary app-store-cta" href={appStoreUrl(appCampaign)} data-app-store-cta="printables-top" data-app-store-campaign={appCampaign}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M16.8 13.1c0-2 1.7-3 1.8-3.1-1-1.4-2.4-1.6-2.9-1.7-1.2-.1-2.4.7-3 0.7-.6 0-1.6-.7-2.6-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7 1.3 0 1.7.7 2.9.7 1.2 0 1.9-1 2.6-2.1.8-1.2 1.2-2.3 1.2-2.4 0 0-2.2-.8-2.2-3.4ZM15 7.1c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1.1 1.7-.9 2.6.9.1 1.9-.5 2.5-1.2Z" fill="currentColor"/>
                </svg>
                Download on the App Store
              </a>
            </div>
          </div>
        </div>
      </section>

      {mazes.map((maze, mazeIndex) => (
        <section class="printable-row" data-printable-row data-maze-index={mazeIndex}>
          <button
            class="printable-preview"
            type="button"
            data-preview-open
            data-maze-index={mazeIndex}
            aria-label={`Preview ${maze.title}`}
          >
            <img
              src={maze.difficulties[0]?.colorPreview ?? maze.preview}
              alt={`${maze.alt} - Easy - full color`}
              loading="lazy"
              width="210"
              height="297"
              data-printable-preview-image
            />
          </button>

          <div class="printable-copy">
            <p class="eyebrow">Printable maze</p>
            <h2>{maze.title}</h2>
            <p>{maze.description}</p>

            <div class="difficulty-control" aria-label={`Choose ${maze.title} difficulty`}>
              {maze.difficulties.map((difficulty, index) => (
                <button
                  type="button"
                  class:list={["difficulty-button", index === 0 && "active"]}
                  data-difficulty-button
                  data-download-href={difficulty.href}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  {difficulty.label}
                </button>
              ))}
            </div>

            <div class="format-control row-format-control" aria-label={`Choose ${maze.title} color style`}>
              <button type="button" class="difficulty-button" data-format-button data-format-choice="bw" aria-pressed="false">Black &amp; white</button>
              <button type="button" class="difficulty-button active" data-format-button data-format-choice="color" aria-pressed="true">Full color</button>
            </div>

            <a class="button printable-download" href={maze.difficulties[0].colorHref} download data-dynamic-download>
              Download Easy Color
            </a>
          </div>
        </section>
      ))}

      <section class="printables-app-cta printables-app-cta-after-mazes">
        <div class="printables-app-cta-inner">
          <img src="/images/denny.png" alt="" width="160" height="160" loading="lazy" />
          <div>
            <p class="eyebrow">Denny's Maze App</p>
            <h2>Want More Mazes? Try Denny's Maze on iPad</h2>
            <p>
              These free printable mazes are for times when you want a simple
              paper activity. Denny's Maze brings the same calm, paper-like
              maze experience to iPad, with 180 mazes across three difficulty
              levels.
            </p>
            <div class="printables-actions">
              <a class="button" href={siteConfig.productPath}>Denny's Maze for iPad</a>
              <a class="button secondary app-store-cta" href={appStoreUrl(appCampaign)} data-app-store-cta="printables-bottom" data-app-store-campaign={appCampaign}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M16.8 13.1c0-2 1.7-3 1.8-3.1-1-1.4-2.4-1.6-2.9-1.7-1.2-.1-2.4.7-3 0.7-.6 0-1.6-.7-2.6-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7 1.3 0 1.7.7 2.9.7 1.2 0 1.9-1 2.6-2.1.8-1.2 1.2-2.3 1.2-2.4 0 0-2.2-.8-2.2-3.4ZM15 7.1c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1.1 1.7-.9 2.6.9.1 1.9-.5 2.5-1.2Z" fill="currentColor"/>
                </svg>
                Download on the App Store
              </a>
            </div>
          </div>
        </div>
      </section>

      <div class="printables-bulk-download">
        <div>
          <p class="eyebrow">Full set</p>
          <h2>Download All {printableCount} Free {themeName} Mazes</h2>
          <p>
            Get the complete set of printable {themeLower} mazes in your chosen
            difficulty. The set includes the leaf, apple, corn, pumpkin, acorn
            and rainy puddle mazes.
          </p>
          <div class="difficulty-control pack-difficulty-control" aria-label="Choose pack difficulty">
            {downloadPacks.map((pack, index) => (
              <button
                type="button"
                class:list={["difficulty-button", index === 2 && "active"]}
                data-pack-difficulty
                data-pack-href={pack.href}
                data-color-pack-href={colorDownloadPacks[index]?.href}
                aria-pressed={index === 2 ? "true" : "false"}
              >
                {pack.label}
              </button>
            ))}
          </div>
          <div class="format-control pack-format-control" aria-label="Choose pack color style">
            <button type="button" class="difficulty-button" data-format-button data-format-choice="bw" aria-pressed="false">Black &amp; white</button>
            <button type="button" class="difficulty-button active" data-format-button data-format-choice="color" aria-pressed="true">Full color</button>
          </div>
        </div>
        <div class="pack-download-actions">
          <a class="button" href={colorDownloadPacks[2]?.href ?? colorDownloadPacks[0]?.href} download data-pack-download>Download Hard Color ZIP</a>
        </div>
      </div>
    </div>
  </section>

  <section class="printables-info">
    <div class="shell printables-shell">
      <h2>Which Maze Difficulty Should I Choose?</h2>
      <dl class="difficulty-guide">
        <div>
          <dt>Easy</dt>
          <dd>Best for younger children, beginners and kids learning how to follow maze paths.</dd>
        </div>
        <div>
          <dt>Medium</dt>
          <dd>A good next step for children who already solve simple mazes comfortably.</dd>
        </div>
        <div>
          <dt>Hard</dt>
          <dd>More turns and decisions for children who want a bigger challenge.</dd>
        </div>
      </dl>
      <p>
        These {themeLower} mazes are designed roughly for ages 2-6, but maze
        experience matters more than exact age. If you're unsure, start with
        Easy and move up.
      </p>

      <h2>How to Print the {themeName} Mazes</h2>
      <ol>
        <li>Choose Easy, Medium or Hard.</li>
        <li>Download the printable PDF.</li>
        <li>Print on regular US Letter or A4 paper using "Fit to page" if needed.</li>
        <li>Let your child solve it with a pencil, crayon or marker.</li>
      </ol>
      <p>You can print one maze at a time or download the complete {themeLower} maze set.</p>
    </div>
  </section>

  <section class="printables-info">
    <div class="shell printables-shell">
      <h2>Frequently Asked Questions</h2>
      <div class="printables-faq">
        {faqItems.map((item) => (
          <section>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </section>
        ))}
      </div>

      <h2>More Free Printable Mazes for Kids</h2>
      <p>
        <a href="/printables/">Browse all free printable mazes for kids</a>.
      </p>
    </div>
  </section>

  <div class="preview-modal" data-preview-modal hidden>
    <div class="preview-backdrop" data-preview-close></div>
    <section class="preview-panel" role="dialog" aria-modal="true" aria-labelledby="preview-title">
      <div class="preview-toolbar">
        <button type="button" class="preview-nav-button" data-preview-prev aria-label="Previous maze">‹</button>
        <div>
          <p class="eyebrow">Printable preview</p>
          <h2 id="preview-title" data-preview-title></h2>
        </div>
        <button type="button" class="preview-nav-button" data-preview-next aria-label="Next maze">›</button>
        <button type="button" class="preview-close" data-preview-close aria-label="Close preview">×</button>
      </div>

      <div class="preview-body">
        <img data-preview-image alt="" />
      </div>

      <div class="preview-actions">
        <div class="difficulty-control preview-difficulty" aria-label="Choose preview difficulty">
          <button type="button" class="difficulty-button active" data-preview-difficulty="0" aria-pressed="true">Easy</button>
          <button type="button" class="difficulty-button" data-preview-difficulty="1" aria-pressed="false">Medium</button>
          <button type="button" class="difficulty-button" data-preview-difficulty="2" aria-pressed="false">Hard</button>
        </div>
        <div class="format-control preview-format" aria-label="Choose preview color style">
          <button type="button" class="difficulty-button" data-format-button data-format-choice="bw" aria-pressed="false">Black &amp; white</button>
          <button type="button" class="difficulty-button active" data-format-button data-format-choice="color" aria-pressed="true">Full color</button>
        </div>
        <a class="button" href="#" download data-preview-download>Download Easy</a>
      </div>
    </section>
  </div>
</article>

<script is:inline type="application/json" id="printable-modal-data" set:html={JSON.stringify(modalMazes)} />

<script>
  const modalDataElement = document.getElementById("printable-modal-data");
  const modalData = modalDataElement?.textContent ? JSON.parse(modalDataElement.textContent) : [];
  const modal = document.querySelector("[data-preview-modal]");
  const modalTitle = document.querySelector("[data-preview-title]");
  const modalImage = document.querySelector("[data-preview-image]");
  const modalDownload = document.querySelector("[data-preview-download]");
  const modalDifficultyButtons = Array.from(document.querySelectorAll("[data-preview-difficulty]"));
  const globalDifficultyButtons = Array.from(document.querySelectorAll("[data-global-difficulty]"));
  const formatButtons = Array.from(document.querySelectorAll("[data-format-button]"));
  const rowDifficultyButtons = Array.from(document.querySelectorAll("[data-difficulty-button]"));
  const packDifficultyButtons = Array.from(document.querySelectorAll("[data-pack-difficulty]"));
  const packDownload = document.querySelector("[data-pack-download]");
  let activeMazeIndex = 0;
  let activeDifficultyIndex = 0;
  let activeFormat = "color";

  document.querySelectorAll("[data-dynamic-download], [data-preview-download], [data-pack-download]").forEach((link) => {
    if (!(link instanceof HTMLAnchorElement)) return;
    link.addEventListener("click", () => {
      // Read the current URL so changes to difficulty and preview maze are reflected.
      const file = new URL(link.href).pathname;
      const match = file.match(/\/([^/]+)-(easy|medium|hard)\.(pdf|zip)$/);
      if (!match) return;

      const [, maze, difficulty, format] = match;
      const location = link.hasAttribute("data-pack-download")
        ? "pack"
        : link.hasAttribute("data-preview-download") ? "preview" : "list";

      window.dispatchEvent(new CustomEvent("printable_maze_download", {
        detail: { maze: format === "zip" ? "all" : maze, difficulty, format, location, file }
      }));
    });
  });

  function setButtonGroupActive(buttons: Element[], index: number, dataAttribute: "difficultyIndex" | "previewDifficulty") {
    buttons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const isActive = Number(button.dataset[dataAttribute]) === index;
      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", isActive ? "true" : "false");
    });
  }

  function updateAllPrintableRows() {
    document.querySelectorAll("[data-printable-row]").forEach((row) => {
      if (!(row instanceof HTMLElement)) return;
      const mazeIndex = Number(row.dataset.mazeIndex ?? 0);
      const maze = modalData[mazeIndex];
      const difficulty = maze?.difficulties?.[activeDifficultyIndex];
      if (!maze || !difficulty) return;

      const previewImage = row.querySelector("[data-printable-preview-image]");
      if (previewImage instanceof HTMLImageElement) {
        previewImage.src = activeFormat === "color" ? difficulty.colorPreview : difficulty.preview;
        previewImage.alt = `${maze.alt} - ${difficulty.label} - ${activeFormat === "color" ? "full color" : "black and white"}`;
      }

      const download = row.querySelector("[data-dynamic-download]");
      if (download instanceof HTMLAnchorElement) {
        download.href = activeFormat === "color" ? difficulty.colorHref : difficulty.href;
        download.textContent = `Download ${difficulty.label} ${activeFormat === "color" ? "Color" : "B&W"}`;
      }

      row.querySelectorAll("[data-difficulty-button]").forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        const isActive = button.dataset.downloadHref === difficulty.href;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
    });
  }

  function setGlobalDifficulty(index: number) {
    activeDifficultyIndex = index;
    setButtonGroupActive(globalDifficultyButtons, index, "difficultyIndex");
    setButtonGroupActive(modalDifficultyButtons, index, "previewDifficulty");
    updateAllPrintableRows();
    updatePreviewModal();
  }

  function setGlobalFormat(format: string) {
    activeFormat = format === "color" ? "color" : "bw";
    formatButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const isActive = button.dataset.formatChoice === activeFormat;
      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", isActive ? "true" : "false");
    });
    updateAllPrintableRows();
    updatePreviewModal();
    updatePackDownload();
  }

  function updatePreviewModal() {
    const maze = modalData[activeMazeIndex];
    const difficulty = maze?.difficulties?.[activeDifficultyIndex];
    if (!maze || !difficulty) return;

    if (modalTitle) modalTitle.textContent = maze.title;
    if (modalImage instanceof HTMLImageElement) {
      modalImage.src = activeFormat === "color" ? difficulty.colorPreview : difficulty.preview;
      modalImage.alt = `${maze.alt} - ${difficulty.label} - ${activeFormat === "color" ? "full color" : "black and white"}`;
    }
    if (modalDownload instanceof HTMLAnchorElement) {
      modalDownload.href = activeFormat === "color" ? difficulty.colorHref : difficulty.href;
      modalDownload.textContent = `Download ${difficulty.label} ${activeFormat === "color" ? "Color" : "B&W"}`;
    }

    modalDifficultyButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const isActive = Number(button.dataset.previewDifficulty) === activeDifficultyIndex;
      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", isActive ? "true" : "false");
    });
  }

  function openPreview(index: number) {
    activeMazeIndex = index;
    updatePreviewModal();
    if (modal instanceof HTMLElement) {
      modal.hidden = false;
      document.body.style.overflow = "hidden";
    }
  }

  function closePreview() {
    if (modal instanceof HTMLElement) {
      modal.hidden = true;
      document.body.style.overflow = "";
    }
  }

  document.querySelectorAll("[data-preview-open]").forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    button.addEventListener("click", () => {
      openPreview(Number(button.dataset.mazeIndex ?? 0));
    });
  });

  document.querySelectorAll("[data-preview-close]").forEach((button) => {
    button.addEventListener("click", closePreview);
  });

  document.querySelector("[data-preview-prev]")?.addEventListener("click", () => {
    activeMazeIndex = (activeMazeIndex - 1 + modalData.length) % modalData.length;
    updatePreviewModal();
  });

  document.querySelector("[data-preview-next]")?.addEventListener("click", () => {
    activeMazeIndex = (activeMazeIndex + 1) % modalData.length;
    updatePreviewModal();
  });

  modalDifficultyButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    button.addEventListener("click", () => {
      setGlobalDifficulty(Number(button.dataset.previewDifficulty ?? 0));
    });
  });

  globalDifficultyButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    button.addEventListener("click", () => {
      setGlobalDifficulty(Number(button.dataset.difficultyIndex ?? 0));
    });
  });

  formatButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    button.addEventListener("click", () => setGlobalFormat(button.dataset.formatChoice ?? "bw"));
  });

  rowDifficultyButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    button.addEventListener("click", () => {
      const row = button.closest("[data-printable-row]");
      const index = Array.from(row?.querySelectorAll("[data-difficulty-button]") ?? []).indexOf(button);
      setGlobalDifficulty(Math.max(0, index));
    });
  });

  document.addEventListener("keydown", (event) => {
    if (!(modal instanceof HTMLElement) || modal.hidden) return;
    if (event.key === "Escape") closePreview();
    if (event.key === "ArrowLeft") {
      activeMazeIndex = (activeMazeIndex - 1 + modalData.length) % modalData.length;
      updatePreviewModal();
    }
    if (event.key === "ArrowRight") {
      activeMazeIndex = (activeMazeIndex + 1) % modalData.length;
      updatePreviewModal();
    }
  });

  packDifficultyButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    button.addEventListener("click", () => {
      packDifficultyButtons.forEach((other) => {
        if (!(other instanceof HTMLButtonElement)) return;
        const isActive = other === button;
        other.classList.toggle("active", isActive);
        other.setAttribute("aria-pressed", isActive ? "true" : "false");
      });

      updatePackDownload();
    });
  });

  function updatePackDownload() {
    const selected = packDifficultyButtons.find((button) => button.classList.contains("active"));
    if (!(selected instanceof HTMLButtonElement) || !(packDownload instanceof HTMLAnchorElement)) return;
    const label = selected.textContent?.trim() ?? "Selected";
    const href = activeFormat === "color" ? selected.dataset.colorPackHref : selected.dataset.packHref;
    if (href) packDownload.href = href;
    packDownload.textContent = `Download ${label} ${activeFormat === "color" ? "Color" : "B&W"} ZIP`;
  }
</script>

<style>
  .printables-article {
    padding: 3.25rem 0 4rem;
  }

  .printables-shell {
    max-width: 58rem;
  }

  .printables-lead {
    color: var(--muted);
  }

  .printables-lead p {
    margin: 0 0 1rem;
  }

  .printables-support {
    margin: 0 0 1.25rem;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .printables-maze-list {
    padding: 1.5rem 0 0;
  }

  .printables-included,
  .printables-info {
    padding: 2rem 0;
  }

  .printables-included {
    border-top: 1px solid var(--line);
  }

  .printables-included p,
  .printables-info p,
  .printables-info li,
  .difficulty-guide dd,
  .printables-faq p {
    color: var(--muted);
  }

  .printables-included ul {
    display: grid;
    gap: 0.35rem 1.5rem;
    margin: 1rem 0;
    padding-left: 1.2rem;
  }

  .printables-global-toolbar {
    display: grid;
    gap: 1rem;
    align-items: center;
    padding: 0 0 1.5rem;
  }

