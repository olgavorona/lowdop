---
import { primaryNav } from "../data/navigation";
import { siteConfig } from "../data/site";
import locales from "../data/locales.json";

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">HA</span>
      <span>
        <strong>{siteConfig.brandName}</strong>
        <small>a calmer digital world for kids</small>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {primaryNav.map((item) => (
          <li>
            {item.children ? (
              <details class="nav-menu">
                <summary>{item.label}</summary>
                <div class="nav-menu-list">
                  {(item.children ?? []).map((child) => (
                    <a href={child.href}>{child.label}</a>
                  ))}
                </div>
              </details>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <details class="language-picker">
      <summary aria-label="Language">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9M12 3c-2.5 2.5-3.8 5.5-3.8 9s1.3 6.5 3.8 9"></path>
        </svg>
      </summary>
      <div class="language-picker-options">
        {locales.map((locale) => (
          <a
            href={locale.code === "en" ? pathname : `/${locale.code}${pathname}`}
            hreflang={locale.code}
            lang={locale.code}
            aria-current={locale.code === "en" ? "page" : undefined}
            data-language-switch={locale.code}
          >
            <span translate="no">{locale.nativeName}</span>
          </a>
        ))}
      </div>
    </details>
  </div>
</header>

<script>
  const picker = document.querySelector<HTMLDetailsElement>(".language-picker");

  document.addEventListener("click", (event) => {
    if (picker?.open && event.target instanceof Node && !picker.contains(event.target)) {
      picker.open = false;
    }
  });

  picker?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      picker.open = false;
      picker.querySelector("summary")?.focus();
    }
  });
</script>
