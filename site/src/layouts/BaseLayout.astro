---
import Analytics from "@vercel/analytics/astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteConfig } from "../data/site";

const telemetryDeckWebAppID = import.meta.env.PUBLIC_TELEMETRYDECK_WEB_APP_ID?.trim();

type Schema = Record<string, unknown>;

type Props = {
  title: string;
  description: string;
  canonical: string;
  image: string;
  type?: "website" | "article";
  ogTitle?: string;
  ogDescription?: string;
  schemas?: Schema[];
};

const {
  title,
  description,
  canonical,
  image,
  type = "website",
  ogTitle = title,
  ogDescription = description,
  schemas = []
} = Astro.props as Props;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:site" content={siteConfig.social.twitterHandle} />
    <meta name="theme-color" content="#f4ebd8" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {telemetryDeckWebAppID && (
      <script
        is:inline
        src="https://cdn.telemetrydeck.com/websdk/telemetrydeck.min.js"
        data-app-id={telemetryDeckWebAppID}
      />
    )}

    {schemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <script>
      import "../scripts/analytics";
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f2f3ef;
    --bg-deep: #e4e5e0;
    --bg-edge: #d7d9d4;
    --bg-soft: #ffffff;
    --surface: rgba(242, 243, 239, 0.92);
    --surface-strong: #ffffff;
    --text: #121833;
    --navy: #121833;
    --muted: #5e6273;
    --faint: #92969f;
    --line: rgba(18, 24, 51, 0.2);
    --line-faint: rgba(18, 24, 51, 0.1);
    --accent: #2026f2;
    --accent-strong: #2026f2;
    --blue: #2026f2;
    --lime: #b9f600;
    --pale-lime: #e7f7ae;
    --terracotta: #2026f2;
    --shadow: none;
    --radius: 0;
    --radius-sm: 0;
    --shell: 76rem;
    --font-body: "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-display: "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-mono: ui-monospace, "SFMono-Regular", Menlo, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--text);
    background: var(--bg);
    font-family: var(--font-body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    font-feature-settings: "kern", "liga";
    overflow-x: hidden;
  }

  a {
    color: var(--accent-strong);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  img {
    max-width: 100%;
    display: block;
  }

  header, main, footer {
    position: relative;
    z-index: 2;
  }

  main {
    min-height: 60vh;
  }

  .shell {
    width: min(calc(100% - 2rem), var(--shell));
    margin: 0 auto;
  }

  .narrow {
    width: min(100%, 46rem);
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 5.1rem);
  }

  h2 {
    font-size: clamp(1.7rem, 4vw, 2.6rem);
  }

  h3 {
    font-size: clamp(1.15rem, 2.5vw, 1.45rem);
  }

  p,
  li,
  td,
  th {
    font-size: 1rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 3rem;
    padding: 0.8rem 1.4rem;
    border-radius: 0;
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-body);
    font-weight: 750;
    font-size: 1rem;
    text-decoration: none;
    border: 1px solid var(--text);
    transition: transform 160ms ease, background 200ms ease;
  }

  .button:hover {
    background: var(--blue);
    transform: translateY(-1px);
    color: var(--bg);
  }

  .button.secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--line);
  }

  .button.secondary:hover {
    background: var(--bg-deep);
    transform: translateY(-1px);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(18px);
    background: rgba(242, 243, 239, 0.92);
    border-bottom: 1px solid var(--line);
  }

  .site-header .shell {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: inherit;
    text-decoration: none;
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand small {
    color: var(--muted);
  }

  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0;
    border: 0;
    background: var(--text);
    color: var(--lime);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
  }

  nav ul,
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.2rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-header nav li {
    display: flex;
    align-items: center;
  }

  .site-header nav a,
  .site-header nav summary,
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 1.6rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-header nav summary:hover,
  .footer-links a:hover {
    color: var(--text);
  }

  .site-header nav summary {
    list-style: none;
    cursor: pointer;
  }

  .site-header nav summary::-webkit-details-marker {
    display: none;
  }

  .nav-menu {
    position: relative;
  }

  .nav-menu summary::after {
    content: "▾";
    margin-left: 0.35rem;
    color: var(--faint);
    font-size: 0.68rem;
    line-height: 1;
  }

  .nav-menu-list {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    display: grid;
    gap: 0.25rem;
    min-width: 12rem;
    padding: 0.55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-strong);
    box-shadow: var(--shadow);
  }

  .nav-menu-list a {
    display: block;
    padding: 0.45rem 0.55rem;
    border-radius: 8px;
  }

  .nav-menu-list a:hover {
    background: var(--bg-deep);
  }

  .hero,
  .content-block,
  .cta-block,
  .page-header {
    padding: 4rem 0;
  }

  .page-header {
    background: var(--navy);
    color: white;
  }

  .page-header .eyebrow {
    color: var(--lime);
  }

  .page-header .section-intro {
    color: rgba(255, 255, 255, 0.72);
  }

  .page-header .stat-list li {
    border-color: rgba(255, 255, 255, 0.3);
    background: transparent;
    color: white;
  }

  .content-block > .shell > h2::before {
    content: "";
    display: block;
    width: 4rem;
    height: 0.4rem;
    margin-bottom: 0.85rem;
    background: var(--lime);
  }

  .hero-grid,
  .split-grid,
  .footer-grid,
  .cards {
    display: grid;
    gap: 1.5rem;
  }

  .hero-card,
  .info-card,
  .link-card,
  .page-panel,
  .media-card {
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-deep);
    box-shadow: var(--shadow);
  }

  .link-card,
  .info-card,
  .media-card {
    border-top: 0.4rem solid var(--blue);
  }

  .hero-copy p,
  .section-intro {
    color: var(--muted);
    max-width: 42rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .stat-list,
  .inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding: 0;
    margin: 1.4rem 0 0;
    list-style: none;
  }

  .stat-list li,
  .inline-links li,
  .tag {
    padding: 0.5rem 0.8rem;
    border-radius: 0;
    border: 1px solid var(--line);
    background: var(--bg-deep);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .cards {
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .media-card {
    overflow: hidden;
  }

  .media-card img,
  .shot-grid img {
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - 8px);
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.7);
  }

  .media-card figure,
  .shot-grid figure {
    margin: 0;
  }

  .media-card figcaption,
  .shot-grid figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .product-hero {
    display: grid;
    gap: 1rem;
    grid-template-columns: 5rem 1fr;
    align-items: center;
  }

  .product-hero img {
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    border-radius: 1.25rem;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.9);
  }

  .shot-grid {
    display: grid;
    gap: 1rem;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-deep);
    box-shadow: var(--shadow);
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  .faq-list {
    display: grid;
    gap: 1rem;
  }

  details {
    padding: 1rem 1.1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--bg-deep);
  }

  summary {
    cursor: pointer;
    font-weight: 700;
  }

  .site-footer {
    padding: 2.5rem 0 4rem;
    border-top: 1px solid var(--line);
  }

  .cta-block {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--navy);
    color: white;
  }

  .cta-block .eyebrow {
    color: var(--lime);
  }

  .cta-block p {
    color: rgba(255, 255, 255, 0.72);
  }

  .cta-block .button {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--navy);
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .prose > * + * {
    margin-top: 1rem;
  }

  .button.lime {
    background: var(--lime);
    color: var(--navy);
    border-color: var(--lime);
  }

  .button.lime:hover {
    background: var(--pale-lime);
    color: var(--navy);
  }

  @media (max-width: 40rem) {
    .site-header nav {
      width: 100%;
    }

    .site-header nav ul {
      gap: 0.45rem 0.9rem;
    }

    .site-header nav a,
    .site-header nav summary {
      font-size: 0.64rem;
    }
  }

  @media (min-width: 50rem) {
    .site-header .shell,
    .hero-grid,
    .split-grid,
    .footer-grid,
    .cta-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .site-header .shell {
      display: grid;
      align-items: center;
    }

    .site-header nav {
      justify-self: end;
    }

    .shot-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
