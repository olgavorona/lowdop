---
import ComparisonTable from "../components/ComparisonTable.astro";
import FaqBlock from "../components/FaqBlock.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { commonFaqs } from "../data/faqs";
import { siteConfig } from "../data/site";
import { buildMeta, organizationSchema } from "../lib/seo";

const meta = buildMeta({
  title: "Harmless Apps | Calm screen time for toddlers",
  description:
    "Find calmer toddler screen time options: Denny's Maze, low-stimulation app recommendations, and practical activity ideas for travel and quiet play.",
  pathname: "/"
});

const comparisonRows = [
  {
    focus: "Pacing",
    calmOption: "Room to slow down and finish a maze at your own pace.",
    typicalOption: "Urgency, countdowns, and pressure to react quickly."
  },
  {
    focus: "Monetization",
    calmOption: "No ads in the play flow.",
    typicalOption: "Frequent interruptions and bait to tap through."
  },
  {
    focus: "Feedback",
    calmOption: "Gentle cues instead of flashing reward loops.",
    typicalOption: "Rapid fireworks, coins, and noisy celebration screens."
  },
  {
    focus: "Goal",
    calmOption: "A maze-book feeling on an iPad.",
    typicalOption: "Retention loops designed to keep the child in the app."
  }
];
---

<BaseLayout {...meta} schemas={[organizationSchema()]}>
  <section class="hero">
    <div class="shell home-hero">
      <div class="hero-copy">
        <p class="eyebrow">Harmless Apps</p>
        <h1>Calmer screen time ideas for toddlers.</h1>
        <p>
          Start with Denny's Maze, compare low-stimulation apps, or read
          practical activity ideas for travel, quiet play, and less chaotic
          screen time.
        </p>
        <ul class="stat-list">
          <li>no ads</li>
          <li>no timers</li>
          <li>no flashing reward loops</li>
          <li>for parents who want less chaotic screen time</li>
        </ul>
      </div>

      <div class="home-paths" aria-label="Start here">
        <article class="home-path featured">
          <img
            src="/images/denny.png"
            alt="Denny character art from Denny's Maze"
            width="512"
            height="512"
            loading="eager"
          />
          <div>
            <p class="eyebrow">Our app</p>
            <h2>Denny's Maze</h2>
            <p>
              A gentle maze-book feeling on iPhone and iPad, with no ads,
              timers, or flashing reward loops.
            </p>
            <div class="path-actions">
              <a class="button" href={siteConfig.productPath}>Learn about Denny's Maze</a>
              <a class="app-store-button ios-install" href={siteConfig.appStoreUrl} hidden>
                <span>Download on the</span>
                <strong>App Store</strong>
              </a>
            </div>
          </div>
        </article>

        <article class="home-path">
          <p class="eyebrow">App guide</p>
          <h2>Best Low-Stimulation Apps</h2>
          <p>
            A parent-friendly list comparing kids apps by pace, sound,
            interruption, and independence.
          </p>
          <a class="button secondary" href="/best-low-stimulation-apps-for-toddlers/">Compare apps</a>
        </article>

        <article class="home-path">
          <p class="eyebrow">Activities</p>
          <h2>Toddler Activity Blog</h2>
          <p>
            Practical ideas for flights, quiet time, and moments when you need
            something calmer than another noisy video.
          </p>
          <a class="button secondary" href="/blog/">Read activities</a>
        </article>
      </div>
    </div>
  </section>

  <section class="content-block">
    <div class="shell">
      <div class="cards">
        <article class="info-card">
          <h3>Written by the maker</h3>
          <p>
            The blog comes from an iOS developer who spent 13 years building
            retention-driven apps and decided to build the opposite for her son.
          </p>
        </article>
        <article class="info-card">
          <h3>Not anti-screen, not pro-chaos</h3>
          <p>
            The site does not claim screens are always bad or always good. It
            focuses on making occasional app time feel less rushed, less loud,
            and less manipulative.
          </p>
        </article>
        <article class="info-card">
          <h3>Clear product language</h3>
          <p>
            You will not see unsupported claims here. The language stays plain:
            designed to be calmer, no ads, no timers, and no flashing reward
            loops.
          </p>
        </article>
      </div>
    </div>
  </section>

  <ComparisonTable
    title="What parents often mean by a calmer kids app"
    intro="Families usually are not asking for magic. They are asking for fewer interruptions, slower pacing, and less pressure."
    rows={comparisonRows}
  />

  <RelatedLinks
    title="Read more"
    links={[
      {
        href: "/best-low-stimulation-apps-for-toddlers/",
        title: "Best low-stimulation apps for toddlers",
        description:
          "How to evaluate calmer apps when your child is still very young."
      },
      {
        href: "/blog/i-spent-13-years-making-apps-impossible-to-put-down/",
        title: "Why I built this",
        description:
          "13 years building retention machinery, then building the opposite for a three-year-old."
      }
    ]}
  />

  <FaqBlock
    title="Common parent questions"
    intro="A quick overview of what this site means by calmer app design."
    items={commonFaqs}
  />

  <script is:inline>
    (() => {
      const isIos =
        /iPad|iPhone|iPod/.test(navigator.userAgent) ||
        (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);

      if (!isIos) return;

      document.documentElement.classList.add("is-ios");
      document.querySelectorAll(".ios-install").forEach((link) => {
        link.removeAttribute("hidden");
      });
    })();
  </script>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    gap: 2rem;
  }

  .home-hero .hero-copy {
    max-width: 52rem;
  }

  .home-paths {
    display: grid;
    gap: 1rem;
  }

  .home-path {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-deep);
    box-shadow: var(--shadow);
  }

  .home-path.featured {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    align-items: center;
  }

  .home-path img {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 1.1rem;
    background: rgba(255, 255, 255, 0.9);
  }

  .home-path h2,
  .home-path p {
    margin: 0;
  }

  .home-path p:not(.eyebrow) {
    color: var(--muted);
  }

  .path-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .app-store-button {
    display: none;
    min-height: 3rem;
    padding: 0.45rem 1rem;
    border-radius: 0.75rem;
    background: #050505;
    color: #fff;
    line-height: 1.05;
    text-decoration: none;
    border: 1px solid #050505;
  }

  .app-store-button span,
  .app-store-button strong {
    display: block;
  }

  .app-store-button span {
    font-size: 0.72rem;
  }

  .app-store-button strong {
    font-size: 1.15rem;
    font-weight: 600;
  }

  :global(html.is-ios) .app-store-button {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 50rem) {
    .home-paths {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .home-path.featured {
      grid-template-columns: 1fr;
    }
  }
</style>
