---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../data/site";
import {
  buildMeta,
  organizationSchema,
  softwareApplicationSchema
} from "../../lib/seo";

const meta = buildMeta({
  title: "Denny's Maze | A calmer maze adventure for kids — no ads, no timers",
  description:
    "Denny's Maze is a calm iOS maze app for young kids. 60 gentle mazes across 3 worlds. No ads, no timers, no flashing rewards. Made by a parent.",
  pathname: siteConfig.productPath
});

const appUrl = siteConfig.appStoreUrl;

const faqs = [
  {
    q: "What age is it really for?",
    a: "Best for children between three and six. Younger children can solve the easy mazes with a finger; older kids enjoy the harder pages and the short story narration. There is no right speed — every page waits."
  },
  {
    q: "Is there any sound?",
    a: "Only a soft narrator reading a short story snippet when a maze is finished. No music, no sound effects, no celebratory chimes. Narration can be muted from the corner button and the mazes work exactly the same way without it."
  },
  {
    q: "Does it work on a phone, or only iPad?",
    a: "It runs on iPhone and iPad. We designed it on iPad — a small hand drawing a path across a larger page feels closest to a real workbook — but the phone experience is equally calm."
  },
  {
    q: "What happens when my child finishes all 60 mazes?",
    a: "They keep working. Three difficulty levels stay interesting for a long time, and many children re-trace mazes for the pleasure of the line itself. New worlds are added with updates at no extra cost for Forever owners."
  },
  {
    q: "Do you collect anything about my child?",
    a: "No personal information. The app collects anonymous, aggregated usage (like which maze tends to take longest) to help improve level design. Nothing is tied to your child or your account."
  }
];
---

<BaseLayout
  {...meta}
  schemas={[organizationSchema(), softwareApplicationSchema()]}
>
  <!-- ==================== HERO ==================== -->
  <section class="dm-hero" id="top">
    <div class="dm-wrap dm-hero-grid">
      <div class="dm-hero-copy">
        <div class="dm-eyebrow" style="margin-bottom: 22px;">A calm maze adventure · ages 3–6 · iPad &amp; iPhone</div>
        <h1 class="dm-h1">
          A quiet maze book<br />
          for <em class="dm-accent">an&nbsp;iPad.</em>
        </h1>
        <p class="dm-sub">
          Help Denny and friends trace a path through 60 gentle labyrinths across
          3 different worlds — no flashing rewards, no timers, no noise.
          Just the feeling of a workbook your child can hold.
        </p>
        <div class="dm-cta-row">
          <a class="dm-btn" href={appUrl}>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M11.182 8.41c-.014-1.41 1.151-2.087 1.204-2.122-.656-.96-1.677-1.092-2.04-1.106-.868-.087-1.697.51-2.138.51-.44 0-1.123-.498-1.847-.484-.95.014-1.825.553-2.314 1.402-.987 1.71-.252 4.243.71 5.633.47.68 1.03 1.443 1.766 1.416.71-.029.978-.46 1.836-.46.858 0 1.1.46 1.85.446.764-.014 1.247-.692 1.713-1.376.54-.79.762-1.553.776-1.592-.017-.008-1.486-.57-1.5-2.267zM9.74 4.337c.39-.475.654-1.13.582-1.78-.563.023-1.244.378-1.648.847-.36.413-.677 1.084-.592 1.726.63.048 1.27-.32 1.658-.793z"/>
            </svg>
            Download on the App Store
          </a>
          <a class="dm-btn dm-btn-ghost" href="#what">
            See how it feels
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 6.5H11M7.5 3L11 6.5L7.5 10"/></svg>
          </a>
        </div>
        <div class="dm-meta">
          <span>Ages 4+</span>
          <i>·</i>
          <span>Works offline</span>
          <i>·</i>
          <span>No ads, ever</span>
          <i>·</i>
          <span>COPPA compliant</span>
        </div>
      </div>

      <div class="dm-device-wrap">
        <div class="dm-device">
          <span class="dm-corner dm-tl"></span>
          <span class="dm-corner dm-tr"></span>
          <span class="dm-corner dm-bl"></span>
          <span class="dm-corner dm-br"></span>
          <div class="dm-screen">
            <img
              src="/images/ipad-maze.png"
              alt="Denny navigating a labyrinth on iPad"
              width="1210"
              height="828"
              loading="eager"
            />
          </div>
          <span class="dm-caption">Pl. V &middot; &ldquo;Denny Builds the Lunar Base&rdquo; &middot; maze 5 of 20</span>
        </div>
      </div>
    </div>
  </section>

  <hr class="dm-rule" />

  <!-- ==================== LEDE / MANIFESTO ==================== -->
  <section class="dm-lede" id="what">
    <div class="dm-wrap dm-side-grid">
      <div>
        <div class="dm-eyebrow">§ 01 — What it is</div>
      </div>
      <div>
        <h2 class="dm-h2">
          Most kids&rsquo; apps are built to <em>capture</em> attention.<br />
          <span class="dm-punch">This one is built to <em>quiet</em> it.</span>
        </h2>
        <p class="dm-body-lg" style="margin-top: 28px;">
          Denny&rsquo;s Maze feels less like a game and more like a paper workbook
          on a tablet. Children drag a finger to draw a path. A friendly voice
          tells them a small story. Nothing flashes. Nothing chirps. Nothing
          tries to keep them tapping for one more minute.
        </p>
        <p class="dm-body-lg dm-quiet" style="margin-top: 18px;">
          When the maze is finished, the page simply turns. That&rsquo;s the whole reward.
        </p>
      </div>
    </div>
  </section>

  <hr class="dm-rule" />

  <!-- ==================== THE THREE NOS ==================== -->
  <section class="dm-nos">
    <div class="dm-wrap">
      <div class="dm-side-grid dm-nos-head">
        <div>
          <div class="dm-eyebrow">§ 02 — The three quiet rules</div>
        </div>
        <div>
          <h2 class="dm-h2">Three things you will <span class="dm-strikethrough">never</span> find inside.</h2>
          <p class="dm-quiet" style="margin-top: 14px; font-size: 1.1rem; max-width: 38ch;">
            The same calm posture, page after page. We chose the absence of features as the feature.
          </p>
        </div>
      </div>

      <div class="dm-nos-cols">
        <div class="dm-no-item">
          <div class="dm-no-num">01 — never</div>
          <h3 class="dm-h3-italic"><span class="dm-x">×</span>Ads or pop-ups</h3>
          <p class="dm-quiet dm-body-sm">No banners between mazes, no cross-promotion, no &ldquo;watch this video for a coin.&rdquo; The page is the page.</p>
        </div>
        <div class="dm-no-item">
          <div class="dm-no-num">02 — never</div>
          <h3 class="dm-h3-italic"><span class="dm-x">×</span>Timers or streaks</h3>
          <p class="dm-quiet dm-body-sm">Nothing counts down. A maze stays open until your child decides they are done. Walk away, come back tomorrow.</p>
        </div>
        <div class="dm-no-item">
          <div class="dm-no-num">03 — never</div>
          <h3 class="dm-h3-italic"><span class="dm-x">×</span>Confetti rewards</h3>
          <p class="dm-quiet dm-body-sm">No fanfare animations, no slot-machine sparkles, no addictive feedback loops. A small &ldquo;well done,&rdquo; and the next page.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="dm-rule" />

  <!-- ==================== INSIDE ==================== -->
  <section class="dm-inside" id="inside">
    <div class="dm-wrap">
      <div class="dm-side-grid dm-inside-top">
        <div>
          <div class="dm-eyebrow">§ 03 — What is inside</div>
        </div>
        <div>
          <h2 class="dm-h2">Sixty small stories<br />across three different worlds.</h2>
          <p class="dm-quiet" style="max-width: 36ch; margin-top: 12px;">Each maze is a single page with a single question. Solve it, listen to the story, turn the page.</p>
        </div>
      </div>

      <div class="dm-stats">
        <div class="dm-stat">
          <div class="dm-stat-label">Stories</div>
          <div class="dm-stat-fig">60<span class="dm-stat-unit">mazes</span></div>
          <p class="dm-quiet dm-body-sm">Three worlds, 20 mazes each — the ocean shore, outer space, and more.</p>
        </div>
        <div class="dm-stat">
          <div class="dm-stat-label">Difficulty</div>
          <div class="dm-stat-fig">3<span class="dm-stat-unit">levels</span></div>
          <p class="dm-quiet dm-body-sm">Easy, Medium, Hard. Grows with the child, slowly. No skill trees, no unlock chains.</p>
        </div>
        <div class="dm-stat">
          <div class="dm-stat-label">Worlds</div>
          <div class="dm-stat-fig">3<span class="dm-stat-unit">worlds</span></div>
          <p class="dm-quiet dm-body-sm">Each world has its own cast of characters and short stories read by a calm, friendly narrator.</p>
        </div>
      </div>

      <div class="dm-practice">
        <div>
          <h3 class="dm-h3-italic" style="font-size: 1.5rem; line-height: 1.3;">And without making a fuss,<br />your child is quietly practicing&hellip;</h3>
        </div>
        <div class="dm-practice-list">
          <div class="dm-practice-item"><span class="dm-practice-n">i.</span><span>Fine-motor control</span></div>
          <div class="dm-practice-item"><span class="dm-practice-n">ii.</span><span>Spatial reasoning</span></div>
          <div class="dm-practice-item"><span class="dm-practice-n">iii.</span><span>Patience and focus</span></div>
          <div class="dm-practice-item"><span class="dm-practice-n">iv.</span><span>Quiet problem-solving</span></div>
        </div>
      </div>
    </div>
  </section>

  <hr class="dm-rule" />

  <!-- ==================== LETTER FROM CREATOR ==================== -->
  <section class="dm-letter">
    <div class="dm-wrap dm-side-grid">
      <div>
        <div class="dm-eyebrow">§ 04 — A note from the maker</div>
      </div>
      <div>
        <h2 class="dm-h2">
          I made this for my son.<br />
          <em>I&nbsp;couldn&rsquo;t find anything calm enough.</em>
        </h2>
        <div class="dm-letter-body">
          <p>
            <span class="dm-drop">I</span>wanted something my son could open on a long flight, on a slow afternoon,
            in the back of a taxi — and put down again ten minutes later without a tantrum.
            Most apps would not let him put them down. Mine had to.
          </p>
          <p>
            So we kept removing things. The score. The stars. The badges. The big bright burst
            when a level ends. What was left was a maze, a friendly character, and the quiet
            sound of a voice reading a small story. That turned out to be enough.
          </p>
          <p>
            If you have ever wished a kids&rsquo; app would just&hellip; <em>be quieter</em>, this is for you too.
          </p>
        </div>
        <div class="dm-sign">Olga Vorona — parent, maker of Denny&rsquo;s Maze</div>
      </div>
    </div>
  </section>

  <hr class="dm-rule" />

  <!-- ==================== MOMENTS ==================== -->
  <section class="dm-moments">
    <div class="dm-wrap">
      <div class="dm-eyebrow" style="margin-bottom: 18px;">§ 05 — Where it fits</div>
      <h2 class="dm-h2 dm-moments-title">Made for the small,<br />in-between moments of a day.</h2>
      <div class="dm-moments-row">
        <div class="dm-moment">
          <div class="dm-moment-num">i. — travel</div>
          <h3 class="dm-h3-italic dm-moment-h">On a long flight</h3>
          <p class="dm-quiet dm-body-sm">Works fully offline. Pack it once, open it at 35,000 feet, finish a maze, hand the iPad back.</p>
        </div>
        <div class="dm-moment">
          <div class="dm-moment-num">ii. — waiting</div>
          <h3 class="dm-h3-italic dm-moment-h">At a restaurant</h3>
          <p class="dm-quiet dm-body-sm">Soft enough for a quiet table. No sudden sound effects, no music that has to be muted in a hurry.</p>
        </div>
        <div class="dm-moment">
          <div class="dm-moment-num">iii. — winding down</div>
          <h3 class="dm-h3-italic dm-moment-h">Before bed</h3>
          <p class="dm-quiet dm-body-sm">A few mazes before lights-out won&rsquo;t spike a small nervous system. The page just turns.</p>
        </div>
        <div class="dm-moment">
          <div class="dm-moment-num">iv. — quiet play</div>
          <h3 class="dm-h3-italic dm-moment-h">While you cook</h3>
          <p class="dm-quiet dm-body-sm">Twenty minutes of focused, fine-motor finger-tracing that doesn&rsquo;t pull a parent back into the room.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="dm-rule" />

  <!-- ==================== PROMISES ==================== -->
  <section class="dm-promises" id="promises">
    <div class="dm-wrap">
      <div class="dm-side-grid dm-promises-head">
        <div>
          <div class="dm-eyebrow">§ 06 — Promises to parents</div>
        </div>
        <div>
          <h2 class="dm-h2">Small print, in plain language.</h2>
          <p class="dm-quiet" style="margin-top: 12px; max-width: 38ch;">No paragraphs you have to read twice. The kind of guarantees we wish every kids&rsquo; app made out loud.</p>
        </div>
      </div>
      <div class="dm-promises-list">
        <div class="dm-promise-item">
          <div class="dm-promise-n">i.</div>
          <div>
            <h3 class="dm-promise-h">No ads. Ever.</h3>
            <p class="dm-quiet dm-body-sm">Not third-party, not first-party, not &ldquo;a friendly suggestion for our other app.&rdquo; None.</p>
          </div>
        </div>
        <div class="dm-promise-item">
          <div class="dm-promise-n">ii.</div>
          <div>
            <h3 class="dm-promise-h">Works offline.</h3>
            <p class="dm-quiet dm-body-sm">The whole adventure ships in the download. Airplane mode, basement, cabin — it still opens.</p>
          </div>
        </div>
        <div class="dm-promise-item">
          <div class="dm-promise-n">iii.</div>
          <div>
            <h3 class="dm-promise-h">COPPA compliant.</h3>
            <p class="dm-quiet dm-body-sm">No analytics tied to your child. Anonymous, aggregated usage only.</p>
          </div>
        </div>
        <div class="dm-promise-item">
          <div class="dm-promise-n">iv.</div>
          <div>
            <h3 class="dm-promise-h">Parental gate.</h3>
            <p class="dm-quiet dm-body-sm">Settings and purchases sit behind a gesture only an adult can solve. Your child stays inside the mazes.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="dm-rule" />

  <!-- ==================== PRICING ==================== -->
  <section class="dm-pricing" id="pricing">
    <div class="dm-wrap">
      <div class="dm-eyebrow" style="margin-bottom: 12px;">§ 07 — Pricing</div>
      <h2 class="dm-h2">One purchase.<br />All ten adventures stay open.</h2>
      <p class="dm-quiet dm-pricing-sub">Start with three free mazes. When you&rsquo;re ready, unlock the rest however suits your family.</p>

      <div class="dm-plans">
        <!-- Featured: Lifetime -->
        <div class="dm-plan dm-plan-featured">
          <span class="dm-ribbon">Most parents choose this</span>
          <div class="dm-plan-label">Forever</div>
          <h3 class="dm-plan-h">The whole adventure,<br />for keeps.</h3>
          <div class="dm-plan-price">$49.99<small>once</small></div>
          <p class="dm-plan-desc">All 60 mazes across all three worlds, every future adventure we add. Pay once, never see another paywall.</p>
          <a class="dm-btn dm-btn-light" href={appUrl}>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M11.182 8.41c-.014-1.41 1.151-2.087 1.204-2.122-.656-.96-1.677-1.092-2.04-1.106-.868-.087-1.697.51-2.138.51-.44 0-1.123-.498-1.847-.484-.95.014-1.825.553-2.314 1.402-.987 1.71-.252 4.243.71 5.633.47.68 1.03 1.443 1.766 1.416.71-.029.978-.46 1.836-.46.858 0 1.1.46 1.85.446.764-.014 1.247-.692 1.713-1.376.54-.79.762-1.553.776-1.592-.017-.008-1.486-.57-1.5-2.267zM9.74 4.337c.39-.475.654-1.13.582-1.78-.563.023-1.244.378-1.648.847-.36.413-.677 1.084-.592 1.726.63.048 1.27-.32 1.658-.793z"/>
            </svg>
            Download on the App Store
          </a>
        </div>
        <!-- Monthly -->
        <div class="dm-plan">
          <div class="dm-plan-label">Monthly</div>
          <h3 class="dm-plan-h">A month of adventures</h3>
          <div class="dm-plan-price">$8.99<small>/ mo</small></div>
          <p class="dm-plan-desc">Full access, billed monthly. Good for a single school break or a long trip. 7-day free trial.</p>
          <a class="dm-btn dm-btn-ghost" href={appUrl}>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M11.182 8.41c-.014-1.41 1.151-2.087 1.204-2.122-.656-.96-1.677-1.092-2.04-1.106-.868-.087-1.697.51-2.138.51-.44 0-1.123-.498-1.847-.484-.95.014-1.825.553-2.314 1.402-.987 1.71-.252 4.243.71 5.633.47.68 1.03 1.443 1.766 1.416.71-.029.978-.46 1.836-.46.858 0 1.1.46 1.85.446.764-.014 1.247-.692 1.713-1.376.54-.79.762-1.553.776-1.592-.017-.008-1.486-.57-1.5-2.267zM9.74 4.337c.39-.475.654-1.13.582-1.78-.563.023-1.244.378-1.648.847-.36.413-.677 1.084-.592 1.726.63.048 1.27-.32 1.658-.793z"/>
            </svg>
            Try free on the App Store
          </a>
        </div>
        <!-- Weekly -->
        <div class="dm-plan">
          <div class="dm-plan-label">Weekly</div>
          <h3 class="dm-plan-h">One week pass</h3>
          <div class="dm-plan-price">$2.99<small>/ wk</small></div>
          <p class="dm-plan-desc">The smallest possible try. Just enough for a quiet weekend or a flight there and back. 3-day free trial.</p>
          <a class="dm-btn dm-btn-ghost" href={appUrl}>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M11.182 8.41c-.014-1.41 1.151-2.087 1.204-2.122-.656-.96-1.677-1.092-2.04-1.106-.868-.087-1.697.51-2.138.51-.44 0-1.123-.498-1.847-.484-.95.014-1.825.553-2.314 1.402-.987 1.71-.252 4.243.71 5.633.47.68 1.03 1.443 1.766 1.416.71-.029.978-.46 1.836-.46.858 0 1.1.46 1.85.446.764-.014 1.247-.692 1.713-1.376.54-.79.762-1.553.776-1.592-.017-.008-1.486-.57-1.5-2.267zM9.74 4.337c.39-.475.654-1.13.582-1.78-.563.023-1.244.378-1.648.847-.36.413-.677 1.084-.592 1.726.63.048 1.27-.32 1.658-.793z"/>
            </svg>
            Try free on the App Store
          </a>
        </div>
      </div>
    </div>
  </section>

  <hr class="dm-rule" />

  <!-- ==================== FAQ ==================== -->
  <section class="dm-faq" id="faq">
    <div class="dm-wrap dm-side-grid">
      <div>
        <div class="dm-eyebrow">§ 08 — Quiet questions</div>
        <h2 class="dm-h2" style="margin-top: 16px;">Things parents ask before they download.</h2>
      </div>
      <div class="dm-faq-qa">
        {faqs.map((item, i) => (
          <details class="dm-details" open={i === 0}>
            <summary class="dm-summary">
              <span class="dm-faq-n">Q.0{i + 1}</span>
              {item.q}
            </summary>
            <p class="dm-quiet" style="margin-top: 14px; font-size: 1rem; max-width: 60ch;">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <hr class="dm-rule" />

  <!-- ==================== FINAL CTA ==================== -->
  <section class="dm-final">
    <div class="dm-wrap" style="text-align: center; position: relative;">
      <h2 class="dm-final-h">
        Start the first maze.<br />
        <span class="dm-ocean"><em>See how it feels.</em></span>
      </h2>
      <p class="dm-quiet dm-final-sub">Then close the iPad, hand it back, and have a quiet ten minutes to yourself.</p>
      <div class="dm-final-cta">
        <a class="dm-btn" href={appUrl}>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M11.182 8.41c-.014-1.41 1.151-2.087 1.204-2.122-.656-.96-1.677-1.092-2.04-1.106-.868-.087-1.697.51-2.138.51-.44 0-1.123-.498-1.847-.484-.95.014-1.825.553-2.314 1.402-.987 1.71-.252 4.243.71 5.633.47.68 1.03 1.443 1.766 1.416.71-.029.978-.46 1.836-.46.858 0 1.1.46 1.85.446.764-.014 1.247-.692 1.713-1.376.54-.79.762-1.553.776-1.592-.017-.008-1.486-.57-1.5-2.267zM9.74 4.337c.39-.475.654-1.13.582-1.78-.563.023-1.244.378-1.648.847-.36.413-.677 1.084-.592 1.726.63.048 1.27-.32 1.658-.793z"/>
          </svg>
          Download on the App Store
        </a>
        <a class="dm-btn dm-btn-ghost" href="#top">Back to the top</a>
      </div>

      <!-- decorative maze line -->
      <svg aria-hidden="true" class="dm-maze-line" viewBox="0 0 900 80" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
        <path d="M10 60 H120 V20 H240 V60 H360 V20 H480 V60 H600 V20 H720 V60 H890" />
        <circle cx="10" cy="60" r="3" fill="currentColor" stroke="none" />
        <path d="M884 56 L894 60 L884 64" />
      </svg>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- layout helpers ---- */
  .dm-wrap {
    width: min(calc(100% - 2rem), 72rem);
    margin: 0 auto;
  }

  .dm-side-grid {
    display: grid;
    grid-template-columns: 0.35fr 0.65fr;
    gap: clamp(24px, 5vw, 80px);
  }

  /* ---- type ---- */
  .dm-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin: 0;
  }

  .dm-h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 400;
    margin: 0 0 0;
    font-variation-settings: "opsz" 60;
  }

  .dm-h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.4vw, 54px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 400;
    margin: 0;
    font-style: italic;
    font-variation-settings: "opsz" 40;
  }

  .dm-h3-italic {
    font-family: var(--font-display);
