---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { appStoreUrl } from "../../../lib/analytics";
import { absoluteUrl, buildMeta, faqSchema, organizationSchema } from "../../../lib/seo";
import { formatLastUpdated, getLastUpdated } from "../../../lib/freshness";

const amazonBookUrl = "https://www.amazon.ca/dp/B0HLXD554F?ref_=pe_125682630_104560520";
const campaign = "website_thanksgiving_printables";
const appUrl = appStoreUrl(campaign);
const assetBase = "/printables/thanksgiving-mazes";
const printables = [
  { number: "01", title: "The Big Autumn Leaf Maze", description: "Meet Tilly the turkey and help Denny find a way through a giant autumn leaf. Count the acorns hiding in the picture, too.", image: `${assetBase}/01-leaf-maze.png`, alt: "Thanksgiving printable maze through a giant autumn leaf with Denny and Tilly the turkey" },
  { number: "02", title: "The Mayflower Ship Maze", description: "Travel with Denny through the Mayflower and find the way up to the top of its sails. Look for the seagulls flying overhead.", image: `${assetBase}/02-ship-maze.png`, alt: "Thanksgiving printable Mayflower ship maze for kids" },
  { number: "03", title: "The Wetu Maze", description: "Learn about the Wampanoag and help Denny find the way through a wetu to its door. Count the butterflies in the meadow.", image: `${assetBase}/03-thanksgiving-maze.png`, alt: "Thanksgiving printable maze through a wetu, a traditional Wampanoag home" },
  { number: "04", title: "The Three Sisters Corn Maze", description: "Help Denny collect corn, beans and squash through a maze shaped like a corn cob. Can you spot the sneaky crow in the field?", image: `${assetBase}/04-three-sisters-corn-maze.png`, alt: "Thanksgiving printable maze through a corn cob, with corn, beans and squash" },
  { number: "05", title: "The Harvest Feast Maze", description: "Follow a spiral maze through the harvest feast to its center. Count the cranberries in the little bowl along the way.", image: `${assetBase}/05-harvest-feast-maze.png`, alt: "Thanksgiving harvest feast printable spiral maze" },
  { number: "06", title: "Sarah Hale’s Letter Maze", description: "Help Denny carry Sarah Josepha Hale’s letter through a long paper maze to President Abraham Lincoln. Count the quill pens on the desk.", image: `${assetBase}/06-thanksgiving-letter-maze.png`, alt: "Thanksgiving history printable maze featuring Sarah Josepha Hale’s letter" },
  { number: "07", title: "Tilly’s Thanksgiving Dinner Maze", description: "Help Tilly get all six yummy foods through her tail feathers and reach the dinner table. Then name three things you are thankful for.", image: `${assetBase}/07-turkey-dinner-maze.png`, alt: "Thanksgiving turkey shaped printable maze with foods and a dinner table" }
];
const faqs = [
  { question: "Are these Thanksgiving mazes free?", answer: "Yes. Download any full-color maze page or get all seven pages in one ZIP, then print at home." },
  { question: "How many pages are included?", answer: "All seven pages of Denny’s Thanksgiving Maze Adventure are included, from the autumn leaf and Mayflower through Tilly’s family dinner." },
  { question: "How do I print the maze pages?", answer: "Open a PNG and print at 100% or choose Fit to page. The 2000 × 3000 pixel pages are designed for standard home printing." },
  { question: "What is a wetu?", answer: "A wetu is a traditional dome-shaped home of the Wampanoag people, who have lived in New England for thousands of years and continue to live there today." }
];
const title = "7 Free Printable Thanksgiving Mazes for Kids";
const description = "Download seven free Thanksgiving maze printables. Follow Denny and Tilly through an autumn story with history, counting and seek-and-find activities throughout.";
const pathname = "/printables/thanksgiving/";
const lastUpdated = getLastUpdated("site/src/pages/printables/thanksgiving/index.astro");
const meta = buildMeta({ title, description, pathname, image: printables[0].image });
const pageSchema = { "@context": "https://schema.org", "@type": "WebPage", name: title, description, url: absoluteUrl(pathname), isPartOf: { "@type": "WebSite", name: "Harmless Apps", url: "https://www.harmlessapp.com" } };
---

<BaseLayout {...meta} ogTitle="Free Printable Thanksgiving Maze Adventure" ogDescription={description} schemas={[organizationSchema(), pageSchema, faqSchema(faqs)]}>
  <article class="thanksgiving-page">
    <section class="thanksgiving-hero">
      <div class="thanks-shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Free 7-page printable story</p>
          <h1>Denny’s Thanksgiving Maze Adventure</h1>
          <p class="last-updated">Last updated: {formatLastUpdated(lastUpdated)}</p>
          <p class="hero-lead">Join Denny and Tilly the turkey for a colorful maze adventure through an autumn leaf, the Mayflower, a wetu, a corn cob, a harvest feast and more. Each page adds a short story fact and a little counting or seek-and-find activity.</p>
          <div class="hero-actions">
            <a class="button thanks-primary" href="#free-printables">Get the free printables</a>
            <a class="text-link" href={`${assetBase}/thanksgiving-mazes.zip`} download>Download all 7 as a ZIP <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-note">Free · Full color · No email required</p>
        </div>
        <figure class="hero-preview"><img src={printables[0].image} alt={printables[0].alt} width="2000" height="3000" loading="eager" /></figure>
      </div>
    </section>

    <section class="offer-section book-offer" aria-labelledby="book-heading">
      <div class="thanks-shell offer-grid">
        <a class="book-cover" href={amazonBookUrl} target="_blank" rel="sponsored noopener" data-amazon-cta="thanksgiving-book-cover" aria-label="See Denny’s Preschool Mazes and Tracing on Amazon">
          <img src="/images/denny-preschool-mazes-book-cover.png" alt="Cover of Denny’s Preschool Mazes and Tracing activity book" width="900" height="696" loading="lazy" />
        </a>
        <div>
          <p class="eyebrow">More pencil-and-paper play</p>
          <h2 id="book-heading">Keep going with 66 mazes and tracing activities</h2>
          <p>Denny’s activity book gives little hands many more paths to trace, puzzles to solve and calm pages to finish at their own pace.</p>
          <a class="button thanks-primary offer-button" href={amazonBookUrl} target="_blank" rel="sponsored noopener" data-amazon-cta="thanksgiving-book-button">See the activity book on Amazon <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="printables-section" id="free-printables" aria-labelledby="printables-heading">
      <div class="thanks-shell">
        <div class="section-heading"><p class="eyebrow">The complete adventure</p><h2 id="printables-heading">Seven mazes from Denny’s Thanksgiving story</h2><p>Print one page or download all seven parts together, from Denny’s autumn journey to Tilly’s family dinner.</p></div>
        <div class="printable-grid">
          {printables.map((item) => (
            <article class="printable-card">
              <a class="printable-image" href={item.image} download aria-label={`Download ${item.title}`}><img src={item.image} alt={item.alt} width="2000" height="3000" loading="lazy" /></a>
              <div class="printable-card-copy"><span class="printable-number">Part {item.number}</span><h3>{item.title}</h3><p>{item.description}</p><a class="download-link" href={item.image} download>Download printable PNG <span aria-hidden="true">↓</span></a></div>
            </article>
          ))}
        </div>
        <div class="all-download"><div><p class="eyebrow">Ready to print</p><h2>Get all seven free maze pages</h2><p>Download the full-resolution Thanksgiving printables together.</p></div><a class="button thanks-primary" href={`${assetBase}/thanksgiving-mazes.zip`} download>Download all 7 free printables</a></div>
      </div>
    </section>

    <section class="offer-section app-offer" aria-labelledby="app-heading">
      <div class="thanks-shell app-grid"><img src="/images/denny.png" alt="Denny the red crab" width="320" height="320" loading="lazy" /><div><p class="eyebrow">More mazes, less noise</p><h2 id="app-heading">Take Denny’s mazes with you</h2><p>Denny’s Maze brings the same calm, paper-like play to iPhone and iPad. Try three mazes free, with no ads, no subscription and no Wi-Fi needed.</p><a class="button thanks-primary offer-button" href={appUrl} data-app-store-cta="thanksgiving-printables" data-app-store-campaign={campaign}>Try Denny’s Maze free <span aria-hidden="true">↗</span></a></div></div>
    </section>

    <section class="info-section"><div class="thanks-shell info-grid"><div><p class="eyebrow">Print at home</p><h2>How to use the printables</h2><ol><li>Download one page or the complete ZIP.</li><li>Open the PNG and print at 100% or choose “Fit to page.”</li><li>Use a pencil, crayon or washable marker to solve each maze.</li><li>Follow Parts 1-7 for the full story and its extra activities.</li></ol></div><div><p class="eyebrow">Questions</p><h2>FAQ</h2><div class="faq-list">{faqs.map((item) => (<details><summary>{item.question}</summary><p>{item.answer}</p></details>))}</div></div></div></section>
  </article>
</BaseLayout>

<style>
  .thanksgiving-page { --thanks-orange:#ef523d; --thanks-yellow:#ffc23c; --thanks-ink:#171d38; }
  .thanks-shell { width:min(calc(100% - 2rem),70rem); margin:0 auto; }
  .thanksgiving-hero { padding:clamp(3.25rem,8vw,7rem) 0; overflow:hidden; background:radial-gradient(circle at 80% 18%,rgba(255,194,60,.3),transparent 22rem),#f6f0e4; border-bottom:1px solid var(--line); }
  .hero-grid { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(18rem,.75fr); gap:clamp(3rem,8vw,7rem); align-items:center; }
  .hero-copy h1 { max-width:12ch; color:var(--thanks-ink); font-size:clamp(3rem,7vw,6.3rem); }
  .hero-lead { max-width:42rem; margin-bottom:1.75rem; color:#565064; font-size:clamp(1.08rem,2vw,1.3rem); }
  .hero-actions { display:flex; flex-wrap:wrap; gap:1rem 1.25rem; align-items:center; }
  .thanks-primary { background:var(--thanks-orange); border-color:var(--thanks-orange); color:white; }
  .thanks-primary:hover { background:var(--thanks-ink); border-color:var(--thanks-ink); color:white; }
  .text-link,.download-link { color:var(--thanks-ink); font-weight:750; }
  .hero-note { margin:1rem 0 0; color:#716a79; font-family:var(--font-mono); font-size:.75rem; }
  .hero-preview { width:min(100%,21rem); margin:0; justify-self:center; padding:.55rem; background:white; border:1px solid rgba(48,32,111,.14); box-shadow:0 22px 55px rgba(35,24,61,.18); transform:rotate(2deg); }
  .hero-preview img,.book-cover img { width:100%; height:auto; }
  .offer-section,.printables-section,.info-section { padding:clamp(3.5rem,8vw,6.5rem) 0; }
  .offer-section { border-bottom:1px solid var(--line); }
  .offer-grid { display:grid; grid-template-columns:minmax(10rem,.55fr) minmax(0,1.45fr); gap:clamp(2rem,7vw,6rem); align-items:center; }
  .book-cover { display:block; background:white; border:1px solid rgba(48,32,111,.18); box-shadow:0 16px 36px rgba(35,24,61,.16); }
  .offer-grid h2,.app-grid h2 { max-width:17ch; }
  .offer-grid p:not(.eyebrow),.app-grid p:not(.eyebrow),.section-heading p,.printable-card p,.all-download p,.info-section li,.faq-list p { color:var(--muted); }
  .offer-button { margin-top:.75rem; }
  .printables-section { background:#fffaf2; }
  .section-heading { max-width:48rem; margin-bottom:2.5rem; }
  .printable-grid { display:grid; border-top:1px solid var(--line); }
  .printable-card { display:grid; grid-template-columns:minmax(15rem,22rem) minmax(0,1fr); gap:clamp(1.5rem,5vw,4rem); align-items:center; padding:2rem 0; border-bottom:1px solid var(--line); }
  .printable-image { display:block; background:white; box-shadow:0 12px 26px rgba(35,24,61,.12); }
  .printable-image img { width:100%; height:auto; transition:transform 180ms ease; }
  .printable-image:hover img { transform:translateY(-3px); }
  .printable-number { color:var(--thanks-orange); font-family:var(--font-mono); font-size:.72rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .printable-card h3 { margin:.4rem 0 .65rem; color:var(--thanks-ink); font-size:clamp(1.35rem,3vw,1.8rem); }
  .all-download { display:grid; grid-template-columns:1fr auto; gap:2rem; align-items:center; margin-top:2.5rem; padding:clamp(1.5rem,5vw,2.5rem); background:var(--thanks-ink); color:white; }
  .all-download h2 { margin-bottom:.4rem; } .all-download p { margin:0; color:#c9c5d8; } .all-download .eyebrow { color:var(--thanks-yellow); }
  .app-offer { background:#dff36f; }
  .app-grid { display:grid; grid-template-columns:minmax(10rem,18rem) minmax(0,1fr); gap:clamp(2rem,7vw,5rem); align-items:center; }
  .app-grid>img { width:100%; filter:drop-shadow(0 16px 18px rgba(18,24,51,.15)); }
  .info-section { background:var(--bg); }
  .info-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(3rem,8vw,7rem); }
  .info-section ol { padding-left:1.25rem; }
  .faq-list details { padding:1rem 0; border-top:1px solid var(--line); }
  .faq-list summary { color:var(--thanks-ink); cursor:pointer; font-weight:750; }
  .faq-list p { margin-bottom:0; }
  @media (max-width:760px) { .hero-grid,.offer-grid,.app-grid,.info-grid { grid-template-columns:1fr; } .hero-preview { width:min(72%,20rem); } .app-grid>img { width:min(60%,14rem); justify-self:center; } .all-download { grid-template-columns:1fr; } }
  @media (max-width:560px) { .printable-card { grid-template-columns:1fr; gap:1.25rem; } .printable-image { width:min(100%,24rem); } .hero-actions .button,.offer-button,.all-download .button { width:100%; } }
  @media (prefers-reduced-motion:reduce) { .printable-image img { transition:none; } }
</style>
