---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { appStoreUrl } from "../../../lib/analytics";
import { absoluteUrl, buildMeta, faqSchema, organizationSchema } from "../../../lib/seo";

const amazonBookUrl = "https://www.amazon.ca/dp/B0HLXD554F?ref_=pe_125682630_104560520";
const appUrl = appStoreUrl("website_halloween_printables");
const assetBase = "/printables/halloween-adventure";

const printables = [
  { number: "01", title: "Boo’s Friendly Ghost Maze", description: "Count the bats and help Denny find a path through Boo’s spooky mist.", image: `${assetBase}/01-friendly-ghost-maze.png`, alt: "Free printable friendly ghost maze for kids with Denny and Boo" },
  { number: "02", title: "Midnight’s Black Cat Maze", description: "Count the whiskers, then tiptoe through Midnight’s moonlit cat maze.", image: `${assetBase}/02-black-cat-maze.png`, alt: "Free printable black cat Halloween maze for kids" },
  { number: "03", title: "The Giant Pumpkin Maze", description: "Find four little pumpkins and guide Denny through the giant jack-o’-lantern.", image: `${assetBase}/03-pumpkin-maze.png`, alt: "Free printable giant pumpkin Halloween maze for kids" },
  { number: "04", title: "The Bubbling Cauldron Maze", description: "Count the bubbles and find a path through the cauldron to the green potion.", image: `${assetBase}/04-cauldron-maze.png`, alt: "Free printable bubbling cauldron Halloween maze for kids" },
  { number: "05", title: "The Haunted House Maze", description: "Collect all six candies and finish Denny’s adventure at the Halloween party door.", image: `${assetBase}/05-haunted-house-maze.png`, alt: "Free printable haunted house Halloween maze for kids" }
];

const faqs = [
  { question: "Are these Halloween printables really free?", answer: "Yes. Download one page or the complete five-page set for free and print it at home." },
  { question: "What ages are the mazes for?", answer: "The broad paths and short counting prompts are designed for preschoolers and young children, roughly ages 3-7." },
  { question: "How should I print the pages?", answer: "Print at 100% or choose Fit to page. The pages work on US Letter and A4 paper; a color printer gives the closest result to the previews." }
];

const title = "5 Free Printable Halloween Mazes for Kids | Story Activity";
const description = "Download 5 free printable Halloween maze activities for kids ages 3-7. Follow Denny through a friendly ghost, black cat, pumpkin, cauldron and haunted house story.";
const pathname = "/printables/halloween-1/";
const meta = buildMeta({ title, description, pathname, image: printables[2].image });
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: absoluteUrl(pathname),
  isPartOf: { "@type": "WebSite", name: "Harmless Apps", url: "https://www.harmlessapp.com" }
};
---

<BaseLayout {...meta} ogTitle="Denny’s Free Halloween Maze Adventure" ogDescription="Five connected, not-too-spooky printable maze activities for kids." schemas={[organizationSchema(), pageSchema, faqSchema(faqs)]}>
  <article class="halloween-page">
    <section class="halloween-hero">
      <div class="halloween-shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Free 5-page printable story</p>
          <h1>Denny’s Halloween Maze Adventure</h1>
          <p class="hero-lead">A friendly ghost, a sleepy black cat, a giant pumpkin, a bubbling cauldron—and a Halloween party at the end. Follow one connected story through five colorful mazes with counting and seek-and-find prompts.</p>
          <div class="hero-actions">
            <a class="button halloween-primary" href="#free-printables">Get the free printables</a>
            <a class="text-link" href={`${assetBase}/dennys-halloween-maze-adventure.zip`} download>Download all 5 as a ZIP <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-note">Free · Full color · Ages 3-7 · No email required</p>
        </div>
        <figure class="hero-preview">
          <img src={printables[0].image} alt={printables[0].alt} width="2000" height="3000" loading="eager" />
        </figure>
      </div>
    </section>

    <section class="offer-section book-offer" aria-labelledby="book-heading">
      <div class="halloween-shell offer-grid">
        <a class="book-cover" href={amazonBookUrl} target="_blank" rel="sponsored noopener" aria-label="See Denny’s Preschool Mazes and Tracing on Amazon">
          <img src="/images/denny-preschool-mazes-book-cover.png" alt="Cover of Denny’s Preschool Mazes and Tracing activity book" width="900" height="696" loading="lazy" />
        </a>
        <div>
          <p class="eyebrow">More pencil-and-paper play</p>
          <h2 id="book-heading">Keep going with 66 mazes and tracing activities</h2>
          <p>Denny’s activity book gives little hands many more paths to trace, puzzles to solve and calm pages to finish at their own pace.</p>
          <a class="button book-button" href={amazonBookUrl} target="_blank" rel="sponsored noopener">See the activity book on Amazon <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="printables-section" id="free-printables" aria-labelledby="printables-heading">
      <div class="halloween-shell">
        <div class="section-heading">
          <p class="eyebrow">The complete adventure</p>
          <h2 id="printables-heading">Five mazes. One Halloween story.</h2>
          <p>Start with Boo and follow the numbered pages in order—or pick a favorite and print just that one.</p>
        </div>
        <div class="printable-grid">
          {printables.map((item) => (
            <article class="printable-card">
              <a class="printable-image" href={item.image} download aria-label={`Download ${item.title}`}>
                <img src={item.image} alt={item.alt} width="2000" height="3000" loading="lazy" />
              </a>
              <div class="printable-card-copy">
                <span class="printable-number">Part {item.number}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <a class="download-link" href={item.image} download>Download printable PNG <span aria-hidden="true">↓</span></a>
              </div>
            </article>
          ))}
        </div>
        <div class="all-download">
          <div><p class="eyebrow">Ready to print</p><h2>Get the whole Halloween adventure</h2><p>All five full-resolution printable pages in one download.</p></div>
          <a class="button halloween-primary" href={`${assetBase}/dennys-halloween-maze-adventure.zip`} download>Download all 5 free printables</a>
        </div>
      </div>
    </section>

    <section class="offer-section app-offer" aria-labelledby="app-heading">
      <div class="halloween-shell app-grid">
        <img src="/images/denny.png" alt="Denny the red crab" width="320" height="320" loading="lazy" />
        <div>
          <p class="eyebrow">More mazes, less noise</p>
          <h2 id="app-heading">Take Denny’s mazes with you</h2>
          <p>Denny’s Maze brings the same calm, paper-like play to iPhone and iPad. Try three mazes free, with no ads, no subscription and no Wi-Fi needed.</p>
          <a class="button app-button" href={appUrl} data-app-store-cta="halloween-printables" data-app-store-campaign="website_halloween_printables">Try Denny’s Maze free <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="info-section">
      <div class="halloween-shell info-grid">
        <div>
          <p class="eyebrow">Print at home</p><h2>How to use the printables</h2>
          <ol><li>Download one page or the complete ZIP.</li><li>Open the PNG and print at 100% or choose “Fit to page.”</li><li>Use a pencil, crayon or washable marker to solve each maze.</li><li>Follow Parts 1-5 to read the full Halloween story.</li></ol>
        </div>
        <div>
          <p class="eyebrow">Questions</p><h2>FAQ</h2>
          <div class="faq-list">{faqs.map((item) => (<details><summary>{item.question}</summary><p>{item.answer}</p></details>))}</div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .halloween-page { --halloween-orange:#ef523d; --halloween-yellow:#ffc23c; --halloween-purple:#30206f; --halloween-ink:#171332; }
  .halloween-shell { width:min(calc(100% - 2rem),70rem); margin:0 auto; }
  .halloween-hero { padding:clamp(3.25rem,8vw,7rem) 0; overflow:hidden; background:radial-gradient(circle at 80% 18%,rgba(255,194,60,.28),transparent 22rem),#f5eee2; border-bottom:1px solid var(--line); }
  .hero-grid { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(18rem,.75fr); gap:clamp(3rem,8vw,7rem); align-items:center; }
  .hero-copy h1 { max-width:11ch; color:var(--halloween-ink); font-size:clamp(3rem,7vw,6.3rem); }
  .hero-lead { max-width:42rem; margin-bottom:1.75rem; color:#565064; font-size:clamp(1.08rem,2vw,1.3rem); }
  .hero-actions { display:flex; flex-wrap:wrap; gap:1rem 1.25rem; align-items:center; }
  .halloween-primary,.book-button,.app-button { background:var(--halloween-orange); border-color:var(--halloween-orange); color:white; }
  .halloween-primary:hover,.book-button:hover,.app-button:hover { background:var(--halloween-purple); border-color:var(--halloween-purple); color:white; }
  .text-link,.download-link { color:var(--halloween-ink); font-weight:750; }
  .hero-note { margin:1rem 0 0; color:#716a79; font-family:var(--font-mono); font-size:.75rem; }
  .hero-preview { width:min(100%,21rem); margin:0; justify-self:center; padding:.55rem; background:white; border:1px solid rgba(48,32,111,.14); box-shadow:0 22px 55px rgba(35,24,61,.18); transform:rotate(2deg); }
  .hero-preview img { width:100%; height:auto; }
  .offer-section,.printables-section,.info-section { padding:clamp(3.5rem,8vw,6.5rem) 0; }
  .offer-section { border-bottom:1px solid var(--line); }
  .offer-grid { display:grid; grid-template-columns:minmax(10rem,.55fr) minmax(0,1.45fr); gap:clamp(2rem,7vw,6rem); align-items:center; }
  .book-cover { display:block; background:white; border:1px solid rgba(48,32,111,.18); box-shadow:0 16px 36px rgba(35,24,61,.16); }
  .book-cover img { width:100%; height:auto; }
  .offer-grid h2,.app-grid h2 { max-width:17ch; }
  .offer-grid p:not(.eyebrow),.app-grid p:not(.eyebrow),.section-heading p,.printable-card p,.all-download p,.info-section li,.faq-list p { color:var(--muted); }
  .book-button,.app-button { margin-top:.75rem; }
  .printables-section { background:#fffaf2; }
  .section-heading { max-width:48rem; margin-bottom:2.5rem; }
  .printable-grid { display:grid; gap:0; border-top:1px solid var(--line); }
  .printable-card { display:grid; grid-template-columns:minmax(15rem,22rem) minmax(0,1fr); gap:clamp(1.5rem,5vw,4rem); align-items:center; padding:2rem 0; border-bottom:1px solid var(--line); }
  .printable-image { display:block; background:white; box-shadow:0 12px 26px rgba(35,24,61,.12); }
  .printable-image img { width:100%; height:auto; transition:transform 180ms ease; }
  .printable-image:hover img { transform:translateY(-3px); }
  .printable-card-copy { padding:0; }
  .printable-number { color:var(--halloween-orange); font-family:var(--font-mono); font-size:.72rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .printable-card h3 { margin:.4rem 0 .65rem; color:var(--halloween-ink); font-size:clamp(1.35rem,3vw,1.8rem); }
  .all-download { display:grid; grid-template-columns:1fr auto; gap:2rem; align-items:center; margin-top:2.5rem; padding:clamp(1.5rem,5vw,2.5rem); background:var(--halloween-ink); color:white; }
  .all-download h2 { margin-bottom:.4rem; } .all-download p { margin:0; color:#c9c5d8; } .all-download .eyebrow { color:var(--halloween-yellow); }
  .app-offer { background:#dff36f; }
  .app-grid { display:grid; grid-template-columns:minmax(10rem,18rem) minmax(0,1fr); gap:clamp(2rem,7vw,5rem); align-items:center; }
  .app-grid>img { width:100%; filter:drop-shadow(0 16px 18px rgba(18,24,51,.15)); }
  .info-section { background:var(--bg); }
  .info-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(3rem,8vw,7rem); }
  .info-section ol { padding-left:1.25rem; }
  .faq-list details { padding:1rem 0; border-top:1px solid var(--line); }
  .faq-list summary { color:var(--halloween-ink); cursor:pointer; font-weight:750; }
  .faq-list p { margin-bottom:0; }
  @media (max-width:760px) {
    .hero-grid,.offer-grid,.app-grid,.info-grid { grid-template-columns:1fr; }
    .hero-preview { width:min(72%,20rem); }
    .app-grid>img { width:min(60%,14rem); justify-self:center; }
    .all-download { grid-template-columns:1fr; }
  }
  @media (max-width:560px) {
    .printable-card { grid-template-columns:1fr; gap:1.25rem; }
    .printable-image { width:min(100%,24rem); }
    .hero-actions .button,.book-button,.app-button,.all-download .button { width:100%; }
  }
  @media (prefers-reduced-motion:reduce) { .printable-image img { transition:none; } }
</style>
