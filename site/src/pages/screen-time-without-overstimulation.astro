---
import ComparisonTable from "../components/ComparisonTable.astro";
import CtaBlock from "../components/CtaBlock.astro";
import PageHeader from "../components/PageHeader.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildMeta, organizationSchema } from "../lib/seo";

const meta = buildMeta({
  title:
    "Screen Time Without Overstimulation | A calmer way to think about kids apps",
  description:
    "How parents can look for screen time that feels less overstimulating, with practical signs of calmer app design.",
  pathname: "/screen-time-without-overstimulation/",
  type: "article"
});

const rows = [
  {
    focus: "Start of session",
    calmOption: "Easy entry into one clear activity.",
    typicalOption: "A loud dashboard of competing options."
  },
  {
    focus: "During play",
    calmOption: "Predictable interaction and gentle pacing.",
    typicalOption: "Frequent novelty spikes to keep arousal high."
  },
  {
    focus: "End of session",
    calmOption: "Natural stopping points.",
    typicalOption: "Retention nudges, streaks, and hard-to-leave loops."
  },
  {
    focus: "Parent experience",
    calmOption: "Feels manageable from the outside.",
    typicalOption: "Feels like you are prying the screen loose."
  }
];
---

<BaseLayout {...meta} schemas={[organizationSchema()]}>
  <PageHeader
    eyebrow="Guide"
    title="Screen time without overstimulation"
    intro="This is not about chasing perfect screen habits. It is about making the digital moments you do allow feel more manageable."
    tags={["screen time", "overstimulation", "kids", "parent guide"]}
  />

  <section class="content-block">
    <div class="shell narrow prose">
      <p>
        Parents often notice the effect of an app before they have words for
        the design choices causing it. One app ends quietly. Another one seems
        to leave a child jumpy, sticky, or frustrated when it is time to stop.
      </p>
      <p>
        Screen time without overstimulation usually comes from simpler
        environments, lower pressure, and fewer tricks aimed at extending a
        session. That does not make an app morally perfect. It just makes the
        experience easier to live with.
      </p>
      <p>
        A calm maze app such as <a href="/apps/dennys-maze/">Denny's Maze</a>
        is one example of this direction: quiet objective, no ads, no timers,
        and no flashing reward loops.
      </p>
    </div>
  </section>

  <ComparisonTable
    title="How overstimulation often enters the experience"
    intro="Parents can use these cues when evaluating any children's app."
    rows={rows}
  />

  <section class="content-block">
    <div class="shell split-grid">
      <article class="page-panel prose">
        <h2>Small changes matter</h2>
        <p>
          Sometimes the difference is not the genre. It is whether the app adds
          constant prompts, celebratory bursts, and time pressure on top of a
          simple activity that could otherwise be calm.
        </p>
      </article>
      <article class="page-panel prose">
        <h2>What this site is trying to do</h2>
        <p>
          Harmless Apps is trying to name and model a quieter alternative. The
          goal is not to shame families for using screens. The goal is to make
          better digital options easier to find.
        </p>
      </article>
    </div>
  </section>

  <RelatedLinks
    links={[
      {
        href: "/calm-ipad-games-for-kids/",
        title: "Calm iPad games for kids",
        description: "A design-focused view of what calm actually looks like."
      },
      {
        href: "/best-low-stimulation-apps-for-toddlers/",
        title: "Best low-stimulation apps for toddlers",
        description:
          "How this thinking applies when the child is especially young."
      },
      {
        href: "/faq/",
        title: "FAQ",
        description: "Quick answers to the most common parent concerns."
      }
    ]}
  />

  <CtaBlock text="If you want one calmer option to start with, Denny's Maze is designed around the idea that screen time can be simpler and quieter." />
</BaseLayout>
