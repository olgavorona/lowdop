---
import CtaBlock from "../components/CtaBlock.astro";
import PageHeader from "../components/PageHeader.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildMeta, organizationSchema } from "../lib/seo";

const meta = buildMeta({
  title:
    "Best Low-Stimulation Apps for Toddlers | What to look for and what to avoid",
  description:
    "A scored comparison of real toddler apps by sounds, animations, rewards, and brightness — so you can see the difference before you hand over the iPad.",
  pathname: "/best-low-stimulation-apps-for-toddlers/",
  type: "article"
});

type OfflineStatus = "yes" | "partial" | "no";

type App = {
  name: string;
  url: string;
  icon: string;
  description: string;
  sounds: number;
  animations: number;
  rewards: number;
  brightness: number;
  offline: OfflineStatus;
  free: boolean;
};

const apps: App[] = [
  {
    name: "Denny's Maze",
    url: "/dennys-maze/",
    icon: "/images/app-icons/dennys-maze.jpg",
    description: "60 guided maze puzzles. Optional story narration; otherwise silent.",
    sounds: 3, animations: 1, rewards: 2, brightness: 3,
    offline: "yes",
    free: true
  },
  {
    name: "Sketchy-Wetchy",
    url: "https://apps.apple.com/us/app/sketchy-wetchy-art-studio/id6575345873",
    icon: "/images/app-icons/sketchy-wetchy.jpg",
    description: "Free-draw canvas with playful brushes and interactive sounds.",
    sounds: 5, animations: 1, rewards: 1, brightness: 5,
    offline: "yes",
    free: true
  },
  {
    name: "Pok Pok",
    url: "https://playpokpok.com/",
    icon: "/images/app-icons/pok-pok.jpg",
    description: "Montessori-inspired open-ended digital toys. Discovery-driven, no goals.",
    sounds: 4, animations: 7, rewards: 2, brightness: 3,
    offline: "yes",
    free: false
  },
  {
    name: "Sago Mini World",
    url: "https://sagomini.com/world/",
    icon: "/images/app-icons/sago-mini.jpg",
    description: "Gentle play scenarios with soft characters. No points or pressure.",
    sounds: 6, animations: 7, rewards: 3, brightness: 4,
    offline: "yes",
    free: true
  },
  {
    name: "PBS Kids",
    url: "https://pbskids.org/apps/",
    icon: "/images/app-icons/pbs-kids.jpg",
    description: "Free games with Daniel Tiger, Dinosaur Train, and others. Fully ad-free.",
    sounds: 5, animations: 7, rewards: 5, brightness: 4,
    offline: "partial",
    free: true
  },
  {
    name: "Toca Life World",
    url: "https://www.tocaboca.com/apps",
    icon: "/images/app-icons/toca-life.jpg",
    description: "Enormous open-world sandbox. Highly interactive; lots happening at once.",
    sounds: 8, animations: 8, rewards: 8, brightness: 7,
    offline: "no",
    free: true
  }
];

function sensoryLoad(app: App): number {
  const sum = app.sounds + app.animations + app.rewards + app.brightness;
  return Math.round((sum / 4) * 10) / 10;
}

function barColor(score: number): string {
  if (score <= 4) return "var(--accent)";
  if (score <= 6) return "var(--terracotta)";
  return "var(--text)";
}

const sorted = [...apps].sort((a, b) => sensoryLoad(a) - sensoryLoad(b));
---

<BaseLayout {...meta} schemas={[organizationSchema()]}>
  <PageHeader
    eyebrow="Guide"
    title="Best low-stimulation apps for toddlers"
    intro="Not just a list of names — a scored look at how real apps compare on the things that actually make screen time feel calm or chaotic."
    tags={["toddlers", "low stimulation", "no ads", "parent guide"]}
  />

  <section class="intro-section">
    <div class="shell narrow prose">
      <p>
        When parents search for low-stimulation apps, they are usually
        describing a feeling: fewer interruptions, less noise, slower pacing,
        and no child who is agitated the moment the screen goes away. The
        problem is that most app descriptions use the word "calm" as a
        marketing claim rather than a design principle.
      </p>
      <p>
        The table below rates real apps across four sensory dimensions —
        sounds, animations, reward feedback, and brightness — on a scale from
        1 (barely there) to 10 (constant and intense). The sensory load is the
        average of the four scores. Lower means calmer.
      </p>
    </div>
  </section>

  <section class="comparison-section">
    <div class="shell">
      <p class="table-label eyebrow">Sensory load comparison</p>

      <!-- Desktop table -->
      <div class="table-wrap">
        <table class="score-table">
          <thead>
            <tr>
              <th class="col-app">App</th>
              <th class="col-score">Sounds</th>
              <th class="col-score">Animations</th>
              <th class="col-score">Rewards</th>
              <th class="col-score">Brightness</th>
              <th class="col-load">Sensory<br />load</th>
              <th class="col-extra">Offline /<br />Travel</th>
              <th class="col-extra">Free<br />content</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((app) => {
              const sl = sensoryLoad(app);
              return (
                <tr>
                  <td class="cell-app">
                    <a
                      href={app.url}
                      class="app-name-link"
                      target={app.url.startsWith("http") ? "_blank" : undefined}
                      rel={app.url.startsWith("http") ? "noopener" : undefined}
                    >
                      <img
                        class="app-icon"
                        src={app.icon}
                        alt={`${app.name} app icon`}
                        width="40"
                        height="40"
                        loading="lazy"
                      />
                      <span class="app-text">
                        <span class="app-name">{app.name}</span>
                        <span class="app-desc">{app.description}</span>
                      </span>
                    </a>
                  </td>
                  {[app.sounds, app.animations, app.rewards, app.brightness].map((score) => (
                    <td class="cell-score">
                      <span class="score-num">{score}</span>
                      <div class="score-track">
                        <div
                          class="score-fill"
                          style={`width: ${score * 10}%; background: ${barColor(score)}`}
                        />
                      </div>
                    </td>
                  ))}
                  <td class="cell-load">
                    <span class="load-num" style={`color: ${barColor(sl)}`}>{sl}</span>
                    <span class="load-denom">/10</span>
                  </td>
                  <td class={`cell-extra offline-${app.offline}`}>
                    {app.offline === "yes" ? "Yes" : app.offline === "partial" ? "Partial" : "No"}
                  </td>
                  <td class={`cell-extra free-${app.free}`}>
                    {app.free ? "Yes" : "No"}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- Mobile cards -->
      <ul class="app-cards">
        {sorted.map((app) => {
          const sl = sensoryLoad(app);
          return (
            <li class="app-card">
              <div class="card-header">
                <a
                  href={app.url}
                  class="card-app-link"
                  target={app.url.startsWith("http") ? "_blank" : undefined}
                  rel={app.url.startsWith("http") ? "noopener" : undefined}
                >
                  <img
                    class="card-icon"
                    src={app.icon}
                    alt={`${app.name} app icon`}
                    width="48"
                    height="48"
                    loading="lazy"
                  />
                  <span class="card-app-name">{app.name}</span>
                </a>
                <span class="card-load" style={`color: ${barColor(sl)}`}>
                  {sl}<span class="card-load-denom">/10</span>
                </span>
              </div>
              <p class="card-desc">{app.description}</p>
              <div class="card-scores">
                {(["sounds", "animations", "rewards", "brightness"] as const).map((dim) => (
                  <div class="card-score-item">
                    <span class="card-dim">{dim}</span>
                    <span class="card-score-num">{app[dim]}</span>
                    <div class="score-track">
                      <div
                        class="score-fill"
                        style={`width: ${app[dim] * 10}%; background: ${barColor(app[dim])}`}
                      />
                    </div>
                  </div>
                ))}
              </div>
              <div class="card-tags">
                <span class={`card-tag offline-${app.offline}`}>
                  {app.offline === "yes" ? "Offline ✓" : app.offline === "partial" ? "Offline ±" : "Online only"}
                </span>
                <span class={`card-tag free-${app.free}`}>
                  {app.free ? "Free content ✓" : "Subscription"}
                </span>
              </div>
            </li>
          );
        })}
      </ul>

      <p class="table-note">Scores 1–10 per dimension · Sensory load = average · Lower is calmer</p>
    </div>
  </section>

  <section class="content-block">
    <div class="shell split-grid">
      <article class="page-panel prose">
        <h2>What the scores actually mean</h2>
        <p>
          <strong>Sounds</strong> measures how much audio the app produces
          during normal play — not just volume, but frequency and surprise.
          A 1 means the child controls most of the sound;
          8–10 means the app is continuously generating it.
        </p>
        <p>
          <strong>Animations</strong> covers how much movement happens on
          screen independent of the child's input. A calm app mostly sits
          still and waits. A busy one never stops moving.
        </p>
      </article>
      <article class="page-panel prose">
        <h2>The dimension parents miss most</h2>
        <p>
          <strong>Rewards</strong> matters most for transition behavior —
          whether the child can put the app down without a fight. Low reward
          scores mean natural stopping points. High scores mean the app builds
          loops that make stopping harder.
        </p>
        <p>
          <strong>Brightness</strong> is about color saturation and contrast,
          not just screen luminosity. High-brightness apps use neon palettes
          designed to hold visual attention.
        </p>
      </article>
    </div>
  </section>

  <RelatedLinks
    links={[
      {
        href: "/dennys-maze/",
        title: "Denny's Maze",
        description: "See one concrete example of a maze app designed to be calmer."
      },
      {
        href: "/blog/i-spent-13-years-making-apps-impossible-to-put-down/",
        title: "Why I built this",
        description:
          "13 years building retention-driven apps, then building the opposite for her son."
      }
    ]}
  />

  <CtaBlock text="If you want a simple starting point, Denny's Maze was built around the kind of checklist parents often wish more kids apps followed." />
</BaseLayout>

<style>
  /* ── Section spacing ── */
  .intro-section {
    padding: 1.5rem 0 1rem;
  }

  .comparison-section {
    padding: 1rem 0 2rem;
  }

  .table-label {
    margin-bottom: 0.75rem;
  }

  /* ── Responsive visibility handled below in each component's rule ── */

  /* ══════════════════════════════
     DESKTOP TABLE
  ══════════════════════════════ */
  .score-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .col-app   { width: 28%; }
  .col-score { width: 8%; }
  .col-load  { width: 9%; }
  .col-extra { width: 10%; }

  thead th {
    padding: 0.75rem 0.75rem;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    background: var(--bg-deep);
    line-height: 1.4;
    vertical-align: bottom;
  }

  thead th.col-score,
  thead th.col-load,
  thead th.col-extra {
    text-align: center;
  }

  .cell-app {
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid var(--line-faint);
    vertical-align: middle;
  }

  .app-name-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }

  .app-name-link:hover .app-name {
    color: var(--accent-strong);
  }

  .app-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 22%;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .app-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .app-name {
    font-weight: 500;
    font-size: 0.88rem;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .app-desc {
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.4;
    white-space: normal;
  }

  .cell-score {
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid var(--line-faint);
    vertical-align: middle;
    text-align: center;
  }

  .score-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .score-track {
    width: 100%;
    max-width: 3rem;
    height: 3px;
    background: var(--line);
    border-radius: 2px;
    margin: 0 auto;
    overflow: hidden;
  }

  .score-fill {
    height: 100%;
    border-radius: 2px;
  }

  .cell-load {
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid var(--line-faint);
    vertical-align: middle;
    text-align: center;
  }

  .load-num {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
  }

  .load-denom {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--faint);
    margin-left: 1px;
  }

  .cell-extra {
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid var(--line-faint);
    vertical-align: middle;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .offline-yes, .free-true   { color: var(--accent-strong); }
  .offline-partial           { color: var(--terracotta); }
  .offline-no, .free-false   { color: var(--faint); }

  .table-note {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--faint);
    text-transform: uppercase;
  }

  /* ══════════════════════════════
     MOBILE CARDS
  ══════════════════════════════ */
  .app-cards {
    display: none; /* shown only on mobile via media query below */
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .app-card {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-deep);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .card-app-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text);
    min-width: 0;
  }

  .card-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 22%;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .card-app-name {
    font-weight: 500;
    font-size: 1rem;
  }

  .card-load {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 500;
    flex-shrink: 0;
    line-height: 1;
  }

  .card-load-denom {
    font-size: 0.65rem;
    color: var(--faint);
    margin-left: 1px;
  }

  .card-desc {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0 0 0.85rem;
    line-height: 1.45;
  }

  .card-scores {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem 1rem;
    margin-bottom: 0.85rem;
  }

  .card-score-item {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 0 0.4rem;
    align-items: center;
  }

  .card-dim {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    grid-column: 1;
    grid-row: 1;
  }

  .card-score-num {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
  }

  .card-score-item .score-track {
    grid-column: 1;
    grid-row: 2;
    max-width: none;
    margin: 0;
    margin-top: 3px;
  }

  .card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-soft);
  }

  .card-tag.offline-yes, .card-tag.free-true   { color: var(--accent-strong); }
  .card-tag.offline-partial                     { color: var(--terracotta); }
  .card-tag.offline-no, .card-tag.free-false    { color: var(--faint); }

  @media (max-width: 44rem) {
    .table-wrap { display: none; }
    .app-cards  { display: grid; }
  }
</style>
