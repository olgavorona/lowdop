---
import CtaBlock from "../components/CtaBlock.astro";
import PageHeader from "../components/PageHeader.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildMeta, organizationSchema } from "../lib/seo";

const meta = buildMeta({
  title:
    "Best Low-Stimulation Apps for Toddlers | What to look for and what to avoid",
  description:
    "A scored comparison of real toddler apps by sounds, animations, rewards, and brightness — so you can see the difference before you hand over the iPad.",
  pathname: "/best-low-stimulation-apps-for-toddlers/",
  type: "article"
});

type OfflineStatus = "yes" | "partial" | "no";

type App = {
  name: string;
  url: string;          // empty string = no link (non-digital items)
  icon?: string;
  iconLabel?: string;
  iconTone?: "blue" | "green" | "pink";
  description: string;
  sounds: number;     // 10 = silent, 1 = constant noise
  animations: number; // 10 = nothing moves, 1 = constant motion
  rewards: number;    // 10 = no reward loops, 1 = heavy engagement mechanics
  brightness: number; // 10 = soft muted palette, 1 = neon / high contrast
  offline: OfflineStatus;
  free: boolean;
};

const apps: App[] = [
  {
    name: "Paper activity book",
    url: "",
    icon: "/images/app-icons/paper-book.svg",
    description: "The original calm screen-free format. Silent, still, no rewards engineered in.",
    sounds: 10, animations: 10, rewards: 10, brightness: 10,
    offline: "yes",
    free: true
  },
  {
    name: "Denny's Maze",
    url: "/dennys-maze/",
    icon: "/images/app-icons/dennys-maze.jpg",
    description: "60 guided maze puzzles. Optional story narration; otherwise silent.",
    sounds: 8, animations: 10, rewards: 9, brightness: 8,
    offline: "yes",
    free: true
  },
  {
    name: "Sketchy-Wetchy",
    url: "https://apps.apple.com/us/app/sketchy-wetchy-art-studio/id6575345873",
    icon: "/images/app-icons/sketchy-wetchy.jpg",
    description: "Free-draw canvas with playful brushes and interactive sounds.",
    sounds: 6, animations: 10, rewards: 10, brightness: 6,
    offline: "yes",
    free: true
  },
  {
    name: "Pok Pok",
    url: "https://playpokpok.com/",
    icon: "/images/app-icons/pok-pok.jpg",
    description: "Montessori-inspired open-ended digital toys. Discovery-driven, no goals.",
    sounds: 7, animations: 4, rewards: 9, brightness: 8,
    offline: "yes",
    free: false
  },
  {
    name: "Sago Mini World",
    url: "https://sagomini.com/world/",
    icon: "/images/app-icons/sago-mini.jpg",
    description: "Gentle play scenarios with soft characters. No points or pressure.",
    sounds: 7, animations: 4, rewards: 8, brightness: 7,
    offline: "yes",
    free: true
  },
  {
    name: "GarageBand",
    url: "https://apps.apple.com/us/app/garageband/id408709785?platform=ipad",
    iconLabel: "GB",
    iconTone: "blue",
    description: "Open-ended music creation with child-controlled sound and no reward loop.",
    sounds: 8, animations: 10, rewards: 10, brightness: 10,
    offline: "yes",
    free: true
  },
  {
    name: "Freeform",
    url: "https://apps.apple.com/us/app/freeform/id6443742539?platform=ipad",
    iconLabel: "FF",
    iconTone: "green",
    description: "Quiet blank-board drawing and arranging, closer to paper than a game.",
    sounds: 10, animations: 10, rewards: 10, brightness: 10,
    offline: "yes",
    free: true
  },
  {
    name: "PBS Kids",
    url: "https://pbskids.org/apps/",
    icon: "/images/app-icons/pbs-kids.jpg",
    description: "Free games with Daniel Tiger, Dinosaur Train, and others. Fully ad-free.",
    sounds: 6, animations: 4, rewards: 6, brightness: 7,
    offline: "partial",
    free: true
  },
  {
    name: "Lucas & Friends Coloring Games",
    url: "https://www.rvappstudios.com/coloring-games-71.html",
    iconLabel: "LC",
    iconTone: "pink",
    description: "Bright coloring and painting modes for toddlers and preschoolers.",
    sounds: 2, animations: 2, rewards: 4, brightness: 3,
    offline: "partial",
    free: true
  },
  {
    name: "Toca Life World",
    url: "https://www.tocaboca.com/apps",
    icon: "/images/app-icons/toca-life.jpg",
    description: "Enormous open-world sandbox. Highly interactive; lots happening at once.",
    sounds: 3, animations: 3, rewards: 3, brightness: 4,
    offline: "no",
    free: true
  }
];

function calmScore(app: App): number {
  const sum = app.sounds + app.animations + app.rewards + app.brightness;
  return Math.round((sum / 4) * 10) / 10;
}

function barColor(score: number): string {
  if (score >= 7) return "var(--accent)";
  if (score >= 5) return "var(--terracotta)";
  return "var(--text)";
}

const sorted = [...apps].sort((a, b) => calmScore(b) - calmScore(a));
---

<BaseLayout {...meta} schemas={[organizationSchema()]}>
  <PageHeader
    eyebrow="Guide"
    title="Best low-stimulation apps for toddlers"
    intro="Not just a list of names — a scored look at how real apps compare on the things that actually make screen time feel calm or chaotic."
    tags={["toddlers", "low stimulation", "no ads", "parent guide"]}
  />

  <section class="intro-section">
    <div class="shell narrow prose">
      <p>
        When parents search for low-stimulation apps, they are usually
        describing a feeling: fewer interruptions, less noise, slower pacing,
        and no child who is agitated the moment the screen goes away. The
        problem is that most app descriptions use the word "calm" as a
        marketing claim rather than a design principle.
      </p>
      <p>
        The table below scores real apps — and one non-digital benchmark —
        across four dimensions: Sounds, Animations, Rewards, and Brightness. Each goes
        from 1 (worst) to 10 (best). The calm score is the average of the four.
        A paper activity book scores 10. Higher means calmer.
      </p>
    </div>
  </section>

  <section class="comparison-section">
    <div class="shell">
      <p class="table-label eyebrow">Sensory load comparison</p>

      <!-- Desktop table -->
      <div class="table-wrap">
        <table class="score-table">
          <thead>
            <tr>
              <th class="col-app">App</th>
              <th class="col-score">Sounds</th>
              <th class="col-score">Animations</th>
              <th class="col-score">Rewards</th>
              <th class="col-score">Brightness</th>
              <th class="col-load">Calm<br />score</th>
              <th class="col-extra">Offline /<br />Travel</th>
              <th class="col-extra">Free<br />content</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((app) => {
              const cs = calmScore(app);
              return (
                <tr>
                  <td class="cell-app">
                    {app.url ? (
                      <a
                        href={app.url}
                        class="app-name-link"
                        target={app.url.startsWith("http") ? "_blank" : undefined}
                        rel={app.url.startsWith("http") ? "noopener" : undefined}
                      >
                        {app.icon ? (
                          <img class="app-icon" src={app.icon} alt={`${app.name} icon`} width="40" height="40" loading="lazy" />
                        ) : (
                          <span class={`app-icon app-icon-fallback icon-${app.iconTone ?? "blue"}`} aria-hidden="true">{app.iconLabel}</span>
                        )}
                        <span class="app-text">
                          <span class="app-name">{app.name}</span>
                          <span class="app-desc">{app.description}</span>
                        </span>
                      </a>
                    ) : (
                      <span class="app-name-link">
                        {app.icon ? (
                          <img class="app-icon" src={app.icon} alt={`${app.name} icon`} width="40" height="40" loading="lazy" />
                        ) : (
                          <span class={`app-icon app-icon-fallback icon-${app.iconTone ?? "blue"}`} aria-hidden="true">{app.iconLabel}</span>
                        )}
                        <span class="app-text">
                          <span class="app-name">{app.name}</span>
                          <span class="app-desc">{app.description}</span>
                        </span>
                      </span>
                    )}
                  </td>
                  {[app.sounds, app.animations, app.rewards, app.brightness].map((score) => (
                    <td class="cell-score">
                      <span class="score-num">{score}</span>
                      <div class="score-track">
                        <div
                          class="score-fill"
                          style={`width: ${score * 10}%; background: ${barColor(score)}`}
                        />
                      </div>
                    </td>
                  ))}
                  <td class="cell-load">
                    <span class="load-num" style={`color: ${barColor(cs)}`}>{cs}</span>
                    <span class="load-denom">/10</span>
                  </td>
                  <td class={`cell-extra offline-${app.offline}`}>
                    {app.offline === "yes" ? "Yes" : app.offline === "partial" ? "Partial" : "No"}
                  </td>
                  <td class={`cell-extra free-${app.free}`}>
                    {app.free ? "Yes" : "No"}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- Mobile cards -->
      <ul class="app-cards">
        {sorted.map((app) => {
          const cs = calmScore(app);
          return (
            <li class="app-card">
              <div class="card-header">
                {app.url ? (
                  <a
                    href={app.url}
                    class="card-app-link"
                    target={app.url.startsWith("http") ? "_blank" : undefined}
                    rel={app.url.startsWith("http") ? "noopener" : undefined}
                  >
                    {app.icon ? (
                      <img class="card-icon" src={app.icon} alt={`${app.name} icon`} width="48" height="48" loading="lazy" />
                    ) : (
                      <span class={`card-icon app-icon-fallback icon-${app.iconTone ?? "blue"}`} aria-hidden="true">{app.iconLabel}</span>
                    )}
                    <span class="card-app-name">{app.name}</span>
                  </a>
                ) : (
                  <span class="card-app-link">
                    {app.icon ? (
                      <img class="card-icon" src={app.icon} alt={`${app.name} icon`} width="48" height="48" loading="lazy" />
                    ) : (
                      <span class={`card-icon app-icon-fallback icon-${app.iconTone ?? "blue"}`} aria-hidden="true">{app.iconLabel}</span>
                    )}
                    <span class="card-app-name">{app.name}</span>
                  </span>
                )}
                <span class="card-load" style={`color: ${barColor(cs)}`}>
                  {cs}<span class="card-load-denom">/10</span>
                </span>
              </div>
              <p class="card-desc">{app.description}</p>
              <div class="card-scores">
                {(["sounds", "animations", "rewards", "brightness"] as const).map((dim) => (
                  <div class="card-score-item">
                    <span class="card-dim">{dim}</span>
                    <span class="card-score-num">{app[dim]}</span>
                    <div class="score-track">
                      <div
                        class="score-fill"
                        style={`width: ${app[dim] * 10}%; background: ${barColor(app[dim])}`}
                      />
                    </div>
                  </div>
                ))}
              </div>
              <div class="card-tags">
                <span class={`card-tag offline-${app.offline}`}>
                  {app.offline === "yes" ? "Offline ✓" : app.offline === "partial" ? "Offline ±" : "Online only"}
                </span>
                <span class={`card-tag free-${app.free}`}>
                  {app.free ? "Free content ✓" : "Subscription"}
                </span>
              </div>
            </li>
          );
        })}
      </ul>

      <p class="table-note">Scores 1–10 per dimension · Calm score = average · 10 = calmest · Higher is better</p>
    </div>
  </section>

  <section class="content-block">
    <div class="shell split-grid">
      <article class="page-panel prose">
        <h2>What the scores mean</h2>
        <p>
          <strong>Sounds (10 = silent)</strong> measures how much audio the app
          produces during normal play — not just volume, but frequency and
          surprise. A 10 means the child controls all the sound, or there is none.
        </p>
        <p>
          <strong>Animations (10 = nothing moves)</strong> covers unprompted motion
          on screen. A calm app sits and waits. A busy one animates constantly
          whether or not the child is touching it.
        </p>
      </article>
      <article class="page-panel prose">
        <h2>The dimension parents miss most</h2>
        <p>
          <strong>Rewards (10 = no reward loops)</strong> matters most for
          transition behavior — whether the child can put it down without a
          fight. High scores mean natural stopping points; low scores mean
          the app is engineered to make stopping harder.
        </p>
        <p>
          <strong>Brightness (10 = soft palette)</strong> is about color saturation
          and contrast. Low-brightness apps use neon palettes designed to hold
          visual attention. Paper scores a 10 here: reflected light only.
        </p>
      </article>
    </div>
  </section>

  <RelatedLinks
    links={[
      {
        href: "/dennys-maze/",
        title: "Denny's Maze",
        description: "See one concrete example of a maze app designed to be calmer."
      },
      {
        href: "/blog/i-spent-13-years-making-apps-impossible-to-put-down/",
        title: "Why I built this",
        description:
          "13 years building retention-driven apps, then building the opposite for her son."
      }
    ]}
  />

  <CtaBlock text="If you want a simple starting point, Denny's Maze was built around the kind of checklist parents often wish more kids apps followed." />
</BaseLayout>

<style>
  /* ── Section spacing ── */
  .intro-section {
    padding: 1.5rem 0 1rem;
  }

  .comparison-section {
    padding: 1rem 0 2rem;
  }

  .table-label {
    margin-bottom: 0.75rem;
  }

  /* ── Responsive visibility handled below in each component's rule ── */

  /* ══════════════════════════════
     DESKTOP TABLE
  ══════════════════════════════ */
  .score-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .col-app   { width: 28%; }
  .col-score { width: 8%; }
  .col-load  { width: 9%; }
  .col-extra { width: 10%; }

  thead th {
    padding: 0.75rem 0.75rem;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    background: var(--bg-deep);
    line-height: 1.4;
    vertical-align: bottom;
  }

  thead th.col-score,
  thead th.col-load,
  thead th.col-extra {
    text-align: center;
  }

  .cell-app {
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid var(--line-faint);
    vertical-align: middle;
  }

  .app-name-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }

  .app-name-link:hover .app-name {
    color: var(--accent-strong);
  }

  .app-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 22%;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .app-icon-fallback {
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--bg);
  }

  .icon-blue {
    background: #4f7fb8;
  }

  .icon-green {
    background: #5f9371;
  }

  .icon-pink {
    background: #b45a78;
  }

  .app-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .app-name {
    font-weight: 500;
    font-size: 0.88rem;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .app-desc {
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.4;
    white-space: normal;
  }

  .cell-score {
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid var(--line-faint);
    vertical-align: middle;
    text-align: center;
  }

  .score-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .score-track {
    width: 100%;
    max-width: 3rem;
    height: 3px;
    background: var(--line);
    border-radius: 2px;
    margin: 0 auto;
    overflow: hidden;
  }

  .score-fill {
    height: 100%;
    border-radius: 2px;
  }

  .cell-load {
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid var(--line-faint);
    vertical-align: middle;
    text-align: center;
  }

  .load-num {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
  }

  .load-denom {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--faint);
    margin-left: 1px;
  }

  .cell-extra {
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid var(--line-faint);
    vertical-align: middle;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .offline-yes, .free-true   { color: var(--accent-strong); }
  .offline-partial           { color: var(--terracotta); }
  .offline-no, .free-false   { color: var(--faint); }

  .table-note {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--faint);
    text-transform: uppercase;
  }

  /* ══════════════════════════════
     MOBILE CARDS
  ══════════════════════════════ */
  .app-cards {
    display: none; /* shown only on mobile via media query below */
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .app-card {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-deep);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .card-app-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text);
    min-width: 0;
  }

  .card-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 22%;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .card-icon.app-icon-fallback {
    font-size: 0.82rem;
  }

  .card-app-name {
    font-weight: 500;
    font-size: 1rem;
  }

  .card-load {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 500;
    flex-shrink: 0;
    line-height: 1;
  }

  .card-load-denom {
    font-size: 0.65rem;
    color: var(--faint);
    margin-left: 1px;
  }

  .card-desc {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0 0 0.85rem;
    line-height: 1.45;
  }

  .card-scores {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem 1rem;
    margin-bottom: 0.85rem;
  }

  .card-score-item {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 0 0.4rem;
    align-items: center;
  }

  .card-dim {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    grid-column: 1;
    grid-row: 1;
  }

  .card-score-num {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
  }

  .card-score-item .score-track {
    grid-column: 1;
    grid-row: 2;
    max-width: none;
    margin: 0;
    margin-top: 3px;
  }

  .card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-soft);
  }

  .card-tag.offline-yes, .card-tag.free-true   { color: var(--accent-strong); }
  .card-tag.offline-partial                     { color: var(--terracotta); }
  .card-tag.offline-no, .card-tag.free-false    { color: var(--faint); }

  @media (max-width: 44rem) {
    .table-wrap { display: none; }
    .app-cards  { display: grid; }
  }
</style>
