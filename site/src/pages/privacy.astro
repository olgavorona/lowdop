---
import PageHeader from "../components/PageHeader.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildMeta, organizationSchema } from "../lib/seo";

const meta = buildMeta({
  title: "Privacy | Harmless Apps",
  description:
    "Privacy information for Harmless Apps and Denny's Maze.",
  pathname: "/privacy/"
});
---

<BaseLayout {...meta} schemas={[organizationSchema()]}>
  <PageHeader
    eyebrow="Privacy"
    title="Privacy"
    intro="How Harmless Apps handles analytics on this website and in Denny's Maze."
  />

  <section class="content-block">
    <div class="shell narrow prose">
      <p><strong>Summary:</strong> Harmless Apps uses privacy-conscious, anonymous analytics and does not run advertising trackers.</p>
      <p>
        This website uses Vercel Web Analytics and TelemetryDeck to understand
        page visits, referral sources, campaign parameters, and clicks on our
        App Store links. TelemetryDeck does not use cookies. We create a random,
        temporary identifier in browser session storage so website events from
        the same tab session can be counted together. It is not connected to an
        identity in the installed app.
      </p>
      <p>
        App Store links may contain Apple campaign parameters. Apple provides
        aggregate reporting about product-page views, downloads, usage, and
        purchases attributed to those links. We do not use those parameters to
        identify individual visitors.
      </p>
      <p>
        Denny's Maze uses TelemetryDeck for anonymous product analytics. The
        app does not send names, email addresses, photos, recordings, contacts,
        or precise location through analytics. Gameplay progress remains on the
        device unless otherwise stated in the app's full privacy policy.
      </p>
    </div>
  </section>

  <RelatedLinks
    links={[
      { href: "/terms/", title: "Terms", description: "Usage and purchase terms." },
    ]}
  />
</BaseLayout>
