---
import AppScorecard from "../../../components/AppScorecard.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { appReviews, scoreDimensions } from "../../../data/appReviews";
import scoreDetails from "../../../data/appScoreDetails.json";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { absoluteUrl, buildMeta, faqSchema, organizationSchema } from "../../../lib/seo";
export function getStaticPaths() { return appReviews.map((review) => ({ params: { slug: review.slug }, props: { review } })); }
const { review } = Astro.props;
const icons: Record<string, string> = { "khan-academy-kids": "/images/app-icons/khan-academy-kids.jpg", "pok-pok": "/images/app-icons/pok-pok.jpg", "montessori-preschool": "/images/app-icons/montessori-preschool.svg", thinkrolls: "/images/app-icons/thinkrolls.jpg", lingo: "/images/app-icons/lingokids.jpg", "sago-mini-school": "/images/app-icons/sago-mini.jpg", "sago-mini-world": "/images/app-icons/sago-mini.jpg", "abc-mouse": "/images/app-icons/abc-mouse.svg" };
const details = scoreDetails[review.slug as keyof typeof scoreDetails];
const humanize = (value: string) => value.replace(/_/g, " ").replace(/\b\w/g, (letter) => letter.toUpperCase());
const weightedScores = [
  { key: "calmness", label: "Calmness", formula: `10 − Attention Intensity (${details.calmness.internalAttentionIntensity.toFixed(4)})`, note: "The component sum is attention intensity, so it is inverted for the public Calmness score.", detail: details.calmness },
  { key: "travel", label: "Travel", formula: "Σ(component value × weight)", detail: details.travel },
  { key: "contentValue", label: "Content value", formula: "Σ(component value × weight)", detail: details.contentValue },
  { key: "commercialExperience", label: "Commercial experience", formula: "Σ(component value × weight)", detail: details.commercialExperience }
] as const;
const pathname = `/ratings/apps/${review.slug}/`;
const meta = buildMeta({ title: `${review.name} Review: Calmness, Offline & Learning Scores`, description: `${review.name} review using recorded gameplay: Calmness ${review.scores.calmness.toFixed(1)}, Travel ${review.scores.travel.toFixed(1)}, and Learning Value ${review.scores.learningValue.toFixed(1)} out of 10. See every component.`, pathname, type: "article" });
const calmAnswer = `${review.name} received a Calmness score of ${review.scores.calmness.toFixed(1)}/10. Higher scores indicate lower measured attention intensity. The score combines visual motion and change, brightness variation, audio intensity and frequency, rewards, and interruptions.`;
const travelAnswer = `${review.name} received a Travel score of ${review.scores.travel.toFixed(1)}/10. This combines offline functionality and reliability, preparation burden, audio independence, commercial interruptions, and accessible content breadth.`;
const learningAnswer = `${review.name} received a Learning Value score of ${review.scores.learningValue.toFixed(1)}/10 based on representative activities. The score measures skill demand, agency, depth, and transferability; it does not claim proven learning outcomes.`;
const faqs = [
  { question: `Is ${review.name} a calm kids app?`, answer: calmAnswer },
  { question: `Does ${review.name} work well for travel and offline use?`, answer: travelAnswer },
  { question: `What is the educational value of ${review.name}?`, answer: learningAnswer }
];
const articleSchema = { "@context": "https://schema.org", "@type": "Article", headline: `${review.name} app review and ratings`, description: meta.description, url: absoluteUrl(pathname), image: absoluteUrl(icons[review.slug]), about: { "@type": "SoftwareApplication", name: review.name, applicationCategory: "EducationalApplication" }, author: { "@type": "Person", name: "Olga Vorona" }, publisher: { "@type": "Organization", name: "Harmless Apps", url: absoluteUrl("/") }, isPartOf: { "@type": "WebSite", name: "Harmless Apps", url: absoluteUrl("/") } };
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Ratings", item: absoluteUrl("/ratings/apps/") }, { "@type": "ListItem", position: 2, name: "App Reviews", item: absoluteUrl("/ratings/apps/") }, { "@type": "ListItem", position: 3, name: review.name, item: absoluteUrl(pathname) }] };
---
<BaseLayout {...meta} schemas={[organizationSchema(), articleSchema, breadcrumbSchema, faqSchema(faqs)]}>
  <nav class="breadcrumbs shell narrow" aria-label="Breadcrumb"><a href="/ratings/apps/">App reviews</a><span aria-hidden="true">/</span><span>{review.name}</span></nav>
  <PageHeader eyebrow="Independent app scorecard · Methodology v0.1" title={`${review.name} review`} intro={review.summary} tags={[review.learningMode, "higher scores are better"]} icon={icons[review.slug]} iconAlt={`${review.name} icon`} />
  <section class="review-section"><div class="shell review-grid"><article class="panel"><p class="eyebrow">Five-dimension scorecard</p><AppScorecard review={review} /></article><aside class="panel context"><h2>How to read this review</h2><p>These dimensions are intentionally separate. A large content library can score well for value while being intense, difficult to use offline, or commercially distracting.</p><p>The scores describe the tested version and sampled experience—not every screen, every child, or future app update.</p></aside></div></section>
  <section class="review-section tinted"><div class="shell"><p class="eyebrow">Score definitions</p><div class="definitions">{scoreDimensions.map((dimension) => <article><h2>{dimension.label}</h2><p>{dimension.short}. <strong>{review.scores[dimension.key].toFixed(1)}/10</strong></p></article>)}</div></div></section>
  <section class="review-section"><div class="shell"><p class="eyebrow">Calculation audit</p><h2>Every value behind the scores</h2><p class="audit-intro">Component values are normalized to 0–10. Contribution is the component value multiplied by its weight. Displayed values are rounded; canonical calculations retain full precision.</p><div class="audit-grid">{weightedScores.map((score) => <article class="audit-card"><header><div><h3>{score.label}</h3><code>{score.formula}</code></div><strong class="result">{score.detail.score.toFixed(4)}</strong></header><div class="table-scroll"><table><thead><tr><th>Component</th><th>Value</th><th>Weight</th><th>Contribution</th></tr></thead><tbody>{score.detail.components.map((component) => <tr><td>{humanize(component.key)}</td><td>{component.value.toFixed(4)}</td><td>{(component.weight * 100).toFixed(0)}%</td><td>{(component.value * component.weight).toFixed(4)}</td></tr>)}</tbody></table></div>{"note" in score && <p class="note">{score.note}</p>}</article>)}</div></div></section>
  <section class="review-section tinted"><div class="shell"><p class="eyebrow">Learning value calculation</p><h2>Representative activities</h2><p><code>{details.learningValue.formula}</code></p><p>App score = weighted mean of activity scores by share of the accessible experience.</p><div class="activity-grid">{details.learningValue.activities.map((activity) => <article class="activity-card"><header><div><h3>{activity.activity_name}</h3><p>{activity.activity_type}</p></div><strong class="result">{activity.score.toFixed(4)}</strong></header><table><thead><tr><th>Component</th><th>0–2 value</th></tr></thead><tbody>{Object.entries(activity.components).map(([key, value]) => <tr><td>{humanize(key.replace(/_score$/, ""))}</td><td>{Number(value).toFixed(2)}</td></tr>)}</tbody></table><dl><div><dt>Experience weight</dt><dd>{(activity.experience_weight * 100).toFixed(0)}%</dd></div><div><dt>Confidence</dt><dd>{humanize(activity.confidence)}</dd></div></dl></article>)}</div><p class="note">The four activity components are equally weighted. Learning Value measures demonstrated interaction demands, not proven learning outcomes.</p></div></section>
  <section class="review-section"><div class="shell review-grid"><article class="panel"><h2>Learning evidence</h2><p><strong>Mode:</strong> {review.learningMode}</p>{review.learningDomains.length ? <><p>The representative activities involved:</p><ul>{review.learningDomains.map((domain) => <li>{domain}</li>)}</ul></> : <p>No learning domains received score credit in the representative sampled activity.</p>}<p class="note">Learning Value reflects demonstrated skill demand, agency, depth, and transferability. It is not evidence of learning outcomes.</p></article><aside class="panel"><h2>Method notes</h2><p>Scores use confirmed observations and recorded gameplay from the Harmless Kids App Measurement Methodology v0.1.</p><p><a href="/ratings/methodology/">Read the full methodology →</a></p><p><a href="/ratings/apps/">← All app reviews</a></p></aside></div></section>
  <section class="review-section seo-questions"><div class="shell narrow"><p class="eyebrow">Common questions</p><h2>{review.name}: calmness, offline use, and educational value</h2><div class="question-list">{faqs.map((item) => <article><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div><p class="comparison-link">Compare this result with <a href="/ratings/apps/">all tested kids apps</a>, or inspect the <a href="/ratings/methodology/">complete rating methodology</a>.</p></div></section>
</BaseLayout>
<style>
  .breadcrumbs { display: flex; gap: .55rem; padding-top: 1.25rem; color: var(--muted); font-family: var(--font-mono); font-size: .7rem; } .breadcrumbs a { color: inherit; }
  .review-section { padding: 2.5rem 0; } .tinted { background: var(--bg-deep); border-block: 1px dashed var(--line); } .review-grid { display: grid; grid-template-columns: 1.35fr .8fr; gap: 1rem; align-items: start; }
  .panel { padding: 1.6rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); } .panel h2 { font-size: 1.65rem; } .context p, .note { color: var(--muted); }
  .definitions { display: grid; grid-template-columns: repeat(5, 1fr); gap: .75rem; } .definitions article { padding: 1.1rem; border-left: 1px solid var(--line); } .definitions h2 { font-size: 1.25rem; } .definitions p { margin: 0; color: var(--muted); }
  .audit-intro { max-width: 48rem; color: var(--muted); } .audit-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; } .audit-card, .activity-card { padding: 1.4rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); } .audit-card header, .activity-card header { display: flex; justify-content: space-between; gap: 1rem; align-items: start; } .audit-card h3, .activity-card h3 { font-size: 1.45rem; margin-bottom: .35rem; } code { color: var(--accent-strong); font-size: .75rem; white-space: normal; } .result { font-family: var(--font-mono); font-size: 1.15rem; color: var(--accent-strong); }
  .table-scroll { overflow-x: auto; } table { width: 100%; margin-top: 1rem; border-collapse: collapse; } th, td { padding: .55rem; border-bottom: 1px solid var(--line); text-align: left; } th { font-family: var(--font-mono); font-size: .65rem; } td:not(:first-child) { font-family: var(--font-mono); font-size: .75rem; }
  .activity-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.5rem; } .activity-card header p { margin: 0; color: var(--muted); } dl { display: flex; gap: 2rem; } dl div { display: grid; } dt { color: var(--muted); font-size: .8rem; } dd { margin: 0; font-family: var(--font-mono); font-size: .75rem; }
  .seo-questions { border-top: 1px dashed var(--line); background: var(--bg-deep); } .question-list { display: grid; gap: 1rem; } .question-list article { padding: 1.25rem 0; border-bottom: 1px solid var(--line); } .question-list h3 { font-size: 1.35rem; } .question-list p, .comparison-link { color: var(--muted); }
  @media (max-width: 850px) { .review-grid, .definitions, .audit-grid, .activity-grid { grid-template-columns: 1fr; } .definitions article { border-left: 0; border-top: 1px solid var(--line); } }
</style>
