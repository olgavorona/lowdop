---
import CtaBlock from "../components/CtaBlock.astro";
import FaqBlock from "../components/FaqBlock.astro";
import PageHeader from "../components/PageHeader.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { commonFaqs } from "../data/faqs";
import { buildMeta, faqSchema, organizationSchema } from "../lib/seo";

const meta = buildMeta({
  title: "FAQ | Harmless Apps and Denny's Maze",
  description:
    "Answers to common questions about Denny's Maze, calmer app design, and the Harmless Apps philosophy.",
  pathname: "/faq/"
});
---

<BaseLayout {...meta} schemas={[organizationSchema(), faqSchema(commonFaqs)]}>
  <PageHeader
    eyebrow="FAQ"
    title="Questions parents usually ask"
    intro="Short answers about what Denny's Maze is, what it is not, and how Harmless Apps thinks about calmer screen time."
    tags={["FAQ", "parents", "Denny's Maze", "calm apps"]}
  />

  <FaqBlock
    title="Frequently asked questions"
    items={commonFaqs}
  />

  <RelatedLinks
    links={[
      {
        href: "/about/",
        title: "About / philosophy",
        description: "Why the site talks about restraint, not hype."
      },
      {
        href: "/apps/dennys-maze/",
        title: "Denny's Maze",
        description: "Product details and App Store CTA."
      },
      {
        href: "/best-low-stimulation-apps-for-toddlers/",
        title: "Low-stimulation toddler apps",
        description: "A practical checklist parents can use elsewhere too."
      }
    ]}
  />

  <CtaBlock text="If the main question is simply where to start, start with Denny's Maze." />
</BaseLayout>
