---
import RelatedLinks from "../components/RelatedLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  buildMeta,
  blogPostingSchema,
  organizationSchema
} from "../lib/seo";

const title = "Best Offline Apps for Kids: 9 Toddler Apps Tested for Flights";
const h1 = "Best Offline Apps for Toddlers: 9 Tested in Airplane Mode";
const description =
  "We tested 9 toddler apps without Wi-Fi to see what really works offline, what needs setup, what to download before a flight, and what each app costs.";
const date = "2026-08-21";
const author = "Olga Vorona";
const pathname = "/offline-toddler-apps/";

const meta = buildMeta({
  title,
  description,
  pathname,
  type: "article"
});

type PrepLevel = "green" | "yellow" | "orange" | "red";

type AppResult = {
  name: string;
  url: string;
  icon: string;
  label?: string;
  badge?: string;
  owned?: boolean;
  freshInstall: string;
  afterSetup: string;
  afterSetupTone: "good" | "warn" | "bad" | "unknown";
  beforeFlight: string;
  prepLevel: PrepLevel;
  freeOffline: string;
  muted: string;
  lowStimulation: string;
  enoughContent: string;
  price: string;
};

const lowStimLink = "/best-low-stimulation-apps-for-toddlers/";
const dennyProductLink = "/dennys-maze/";
const dennyAppStoreLink =
  "https://apps.apple.com/ca/app/dennys-maze/id6760107138";
const planeLink =
  "/blog/what-actually-works-on-a-plane-with-a-3-year-old-after-10-flights/";

const apps: AppResult[] = [
  {
    name: "Denny's Maze",
    url: dennyAppStoreLink,
    icon: "/images/app-icons/dennys-maze.jpg",
    label: "Our app",
    badge: "Our pick for zero-prep offline use",
    owned: true,
    freshInstall: "✅ 3 complete mazes available immediately",
    afterSetup: "✅ Same 3 mazes available",
    afterSetupTone: "good",
    beforeFlight: "🟢 Just download",
    prepLevel: "green",
    freeOffline: "3 complete mazes",
    muted: "◐ Narration is used",
    lowStimulation: "8.8/10 calm score",
    enoughContent: "✅ Yes with full access",
    price: "$7.99 lifetime"
  },
  {
    name: "Sago Mini World",
    url: "https://apps.apple.com/us/app/sago-mini-world-kids-games/id874425722",
    icon: "/images/app-icons/sago-mini.jpg",
    freshInstall: "❌ Nothing available without setup",
    afterSetup:
      "✅ Around 4 games available without subscribing or manually downloading them first",
    afterSetupTone: "good",
    beforeFlight:
      "🟢 A few games work after setup; more content requires paid access/downloads",
    prepLevel: "green",
    freeOffline: "Around 4 games in our test",
    muted: "✅ Yes",
    lowStimulation: "6.5/10 calm score",
    enoughContent: "✅ Yes",
    price: "$79.99/year · 1-week trial"
  },
  {
    name: "Pok Pok",
    url: "https://apps.apple.com/us/app/pok-pok-montessori-preschool/id1550204730",
    icon: "/images/app-icons/pok-pok.jpg",
    freshInstall:
      "⚠️ Setup worked, but no activities were available without a subscription. Initial setup took approximately 2 minutes in our test.",
    afterSetup: "❌ Nothing usable",
    afterSetupTone: "bad",
    beforeFlight: "🔴 Internet + subscription required for meaningful access",
    prepLevel: "red",
    freeOffline: "None",
    muted: "✅ Yes",
    lowStimulation: "7/10 calm score",
    enoughContent: "✅ Yes if subscribed",
    price: "$59.99/year with 1-week trial or $9.99/month"
  },
  {
    name: "Khan Academy Kids",
    url: "https://apps.apple.com/us/app/khan-academy-kids/id1378467217",
    icon: "/images/app-icons/khan-academy-kids.jpg",
    freshInstall: "❌ Could not complete initial setup",
    afterSetup: "🟡 Dedicated offline section available",
    afterSetupTone: "warn",
    beforeFlight: "🟡 Complete initial setup online first",
    prepLevel: "yellow",
    freeOffline: "Some",
    muted: "◐ Narration is used",
    lowStimulation: "Not rated in our low-stimulation comparison",
    enoughContent: "✅ Yes",
    price: "Free"
  },
  {
    name: "PBS KIDS Games",
    url: "https://apps.apple.com/us/app/pbs-kids-games/id1050773989",
    icon: "/images/app-icons/pbs-kids.jpg",
    freshInstall: "❌ Nothing available",
    afterSetup: "✅ Everything we manually downloaded was available",
    afterSetupTone: "good",
    beforeFlight:
      "🟠 Manually download each game you want before leaving Wi-Fi",
    prepLevel: "orange",
    freeOffline:
      "Potentially substantial, but only games downloaded beforehand",
    muted: "◐ Narration is used",
    lowStimulation: "5.8/10 calm score",
    enoughContent: "✅ Yes, but needs to be downloaded",
    price: "Free"
  },
  {
    name: "Thinkrolls",
    url: "https://apps.apple.com/us/app/thinkrolls-fun-kids-games-2-8/id1530907314",
    icon: "/images/app-icons/thinkrolls.jpg",
    freshInstall: "❌ Crashed during our test",
    afterSetup: "❌ Nothing usable in the tested free state",
    afterSetupTone: "bad",
    beforeFlight: "🔴 Internet + paid access required",
    prepLevel: "red",
    freeOffline: "None in our test",
    muted: "✅ Yes",
    lowStimulation: "Not rated in our low-stimulation comparison",
    enoughContent: "✅ Yes if subscribed and downloaded",
    price: "$69.99/year · 1-week trial"
  },
  {
    name: "Lingokids",
    url: "https://apps.apple.com/us/app/lingokids-play-and-learn/id1002043426",
    icon: "/images/app-icons/lingokids.jpg",
    freshInstall:
      "❌ Stayed in an endless loading state during our test",
    afterSetup: "❌ Nothing usable",
    afterSetupTone: "bad",
    beforeFlight: "🔴 Subscription required; download content after purchase",
    prepLevel: "red",
    freeOffline: "None in our test",
    muted: "◐ Narration is used",
    lowStimulation: "Not rated in our low-stimulation comparison",
    enoughContent: "✅ Yes if purchased and downloaded",
    price: "$89.99/year · 1-week trial"
  },
  {
    name: "Montessori Preschool",
    url: "https://apps.apple.com/us/app/montessori-preschool-kids-3-7/id1138436619",
    icon: "/images/app-icons/montessori-preschool.svg",
    freshInstall:
      "⚠️ Setup worked, and some free content was visible, but activities were not usable offline",
    afterSetup:
      "🟡 Exercises that had previously been opened/downloaded remained available",
    afterSetupTone: "warn",
    beforeFlight:
      "🟠 Open/download individual sections and exercises online first",
    prepLevel: "orange",
    freeOffline: "Some, if prepared beforehand",
    muted: "◐ Narration is used",
    lowStimulation: "Not rated in our low-stimulation comparison",
    enoughContent: "✅ Yes if subscribed and downloaded",
    price: "$59.99/year · 1-week trial"
  },
  {
    name: "Bimi Boo Learning Games",
    url: "https://apps.apple.com/us/app/learning-games-for-toddlers-2/id1084997102",
    icon: "/images/app-icons/bimi-boo-learning-games.jpg",
    freshInstall: "❌ Nothing usable without purchase",
    afterSetup: "❌ Nothing usable in the tested free state",
    afterSetupTone: "bad",
    beforeFlight: "🔴 Internet + purchase + manually download each game",
    prepLevel: "red",
    freeOffline: "None",
    muted: "◐ Narration is used",
    lowStimulation: "Not rated in our low-stimulation comparison",
    enoughContent: "✅ Yes if subscribed and downloaded",
    price: "$59.99/year"
  }
];

const articleSchema = blogPostingSchema({
  title,
  description,
  datePublished: date,
  pathname,
  authorName: author
});
---

<BaseLayout
  {...meta}
  ogTitle="Best Offline Apps for Toddlers: 9 Tested in Airplane Mode"
  ogDescription="We disconnected the iPad and tested what really works, what needs Wi-Fi first, and which games must be downloaded before takeoff."
  schemas={[organizationSchema(), articleSchema]}
>
  <article>
    <header class="article-hero">
      <div class="shell narrow">
        <h1>{h1}</h1>
        <p class="lead">
          "Works offline" sounds simple until you're already on a plane and
          discover that the app needed an account, a subscription, or ten
          individual downloads before takeoff.
        </p>
      </div>
    </header>

    <section class="intro-section">
      <div class="shell narrow prose">
        <p>
          So we tested nine popular toddler apps ourselves.
        </p>
        <p>
          First, we downloaded each app and opened it with no internet at all.
          Then we gave it one normal online setup, disconnected again,
          force-quit the app, and checked what was actually available.
        </p>
        <p>
          The differences were much bigger than we expected. Some apps were
          ready immediately. Some needed an internet connection just to get
          through setup. Others worked offline only for games or exercises we'd
          remembered to download beforehand.
        </p>
        <p>
          If you're loading an iPad before a flight, this is the part that
          actually matters.
        </p>
      </div>
    </section>

    <section class="comparison-section" aria-labelledby="comparison-heading">
      <div class="shell">
        <div class="section-head compact">
          <h2 id="comparison-heading">Offline toddler app comparison</h2>
        </div>

        <div class="table-wrap" aria-label="Offline toddler app comparison table">
          <table class="offline-table">
            <thead>
              <tr>
                <th>App</th>
                <th>Fresh install, no internet</th>
                <th>Offline after one online setup, no subscription</th>
                <th>Before your flight</th>
                <th>Free offline content</th>
                <th>Works well muted?</th>
                <th><a class="header-link" href={lowStimLink}>Low stimulation?</a></th>
                <th>Enough offline content for 10-30 minutes?</th>
                <th>Price when tested</th>
              </tr>
            </thead>
            <tbody>
              {apps.map((app) => (
                <tr class={app.owned ? "owned-row" : undefined}>
                  <td class="app-cell">
                    <a
                      class="app-link"
                      href={app.url}
                      target="_blank"
                      rel="noopener"
                    >
                      <img src={app.icon} alt="" width="34" height="34" loading="lazy" />
                      <strong>{app.name}</strong>
                    </a>
                    {app.label && <span class="small-label">{app.label}</span>}
                    {app.badge && <span class="pick-badge">{app.badge}</span>}
                  </td>
                  <td>{app.freshInstall}</td>
                  <td class={`result-${app.afterSetupTone}`}>{app.afterSetup}</td>
                  <td><span class={`prep-badge prep-${app.prepLevel}`}>{app.beforeFlight}</span></td>
                  <td>{app.freeOffline}</td>
                  <td>{app.muted}</td>
                  <td>{app.lowStimulation}</td>
                  <td class="needs-verification">{app.enoughContent}</td>
                  <td>{app.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <ul class="mobile-results">
          {apps.map((app) => (
            <li class={app.owned ? "mobile-card owned-card" : "mobile-card"}>
              <div class="mobile-card-head">
                <a
                  class="mobile-app-link"
                  href={app.url}
                  target="_blank"
                  rel="noopener"
                >
                  <img src={app.icon} alt="" width="40" height="40" loading="lazy" />
                  <h3>{app.name}</h3>
                </a>
                {app.label && <span class="small-label">{app.label}</span>}
              </div>
              {app.badge && <span class="pick-badge">{app.badge}</span>}
              <dl>
                <div>
                  <dt>Fresh install, no internet</dt>
                  <dd>{app.freshInstall}</dd>
                </div>
                <div>
                  <dt>Offline after setup</dt>
                  <dd>{app.afterSetup}</dd>
                </div>
                <div>
                  <dt>Before your flight</dt>
                  <dd><span class={`prep-badge prep-${app.prepLevel}`}>{app.beforeFlight}</span></dd>
                </div>
                <div>
                  <dt>Free offline content</dt>
                  <dd>{app.freeOffline}</dd>
                </div>
                <div>
                  <dt>Muted?</dt>
                  <dd>{app.muted}</dd>
                </div>
                <div>
                  <dt>Low stimulation?</dt>
                  <dd>{app.lowStimulation}</dd>
                </div>
                <div>
                  <dt>10-30 minutes?</dt>
                  <dd class="needs-verification">{app.enoughContent}</dd>
                </div>
                <div>
                  <dt>Price when tested</dt>
                  <dd>{app.price}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ul>

        <div class="table-notes">
          <p>
            Prices shown are the USD prices we saw during our August 2026
            testing. App Store prices can change and may vary by country.
          </p>
          <p>
            <a href={lowStimLink}>How we rate stimulation →</a>
            Our low-stimulation ratings come from a separate comparison looking
            at brightness, animation, rewards and sound.
          </p>
        </div>
      </div>
    </section>

    <section class="method-section" aria-labelledby="method-heading">
      <div class="shell">
        <div class="method-box">
          <h2 id="method-heading">How we tested</h2>
          <p>
            We weren't interested in whether an app technically describes
            itself as "offline." We wanted to know what happens in the
            situation parents actually face when traveling.
          </p>

          <h3>Fresh install, no internet</h3>
          <p>
            We downloaded each app, disconnected completely, and opened it for
            the first time. We recorded whether setup worked and whether any
            actual activities were available.
          </p>

          <h3>One normal online setup</h3>
          <p>
            Next, we connected to the internet and completed the app's initial
            setup. We recorded subscriptions, purchases, and any content that
            had to be downloaded manually.
          </p>

          <h3>Offline again</h3>
          <p>
            We disconnected, force-quit the app, reopened it, and tried to start
            activities.
          </p>
          <p>
            We tested both Airplane Mode and having networking enabled with no
            usable internet connection.
          </p>
          <p>
            In our tests the apps behaved the same in both offline states, so
            the comparison combines them into one "Offline after setup" result.
          </p>

          <h3>Sound</h3>
          <p>
            We also checked whether the core experience worked without sound,
            because that's useful on planes, restaurants and other shared
            spaces.
          </p>
          <p>
            Prices are the USD prices we saw during our August 2026 testing.
            App Store prices can change and vary by country.
          </p>
        </div>
      </div>
    </section>

    <section class="content-block" aria-labelledby="immediate-heading">
      <div class="shell narrow prose">
        <h2 id="immediate-heading">What works if you forget to prepare before the flight?</h2>
        <p>
          The biggest surprise wasn't whether apps had offline support. It was
          how much preparation "offline" sometimes required.
        </p>
        <p>
          If you download an app at the airport and immediately lose internet,
          several popular options give you very little to work with.
        </p>
        <p>
          <strong>Denny's Maze</strong> was usable immediately in our test, with
          three complete free mazes and no additional download.
        </p>
        <p>
          <strong>Pok Pok</strong> let us complete its roughly two-minute setup
          offline, but no activities were available without subscribing.
        </p>
        <p>
          <strong>Khan Academy Kids</strong> couldn't complete its initial setup
          without internet.
        </p>
        <p>
          <strong>PBS KIDS Games</strong> had no games ready offline until we
          connected and manually downloaded them.
        </p>
        <p>
          <strong>Montessori Preschool</strong> let us get through setup, but
          activities themselves weren't available offline until we'd
          opened/downloaded them online.
        </p>
        <p>
          <strong>Thinkrolls</strong> crashed during our fresh-install offline
          test, while <strong>Lingokids</strong> remained on a loading screen
          during our test.
        </p>
        <p class="tip-box">
          Before a flight, don't just download an app. Open it, turn on Airplane
          Mode, force-quit it, reopen it, and try the activities your child will
          actually use.
        </p>
      </div>
    </section>

    <section class="content-block tinted" aria-labelledby="picks-heading">
      <div class="shell narrow prose">
        <h2 id="picks-heading">Best toddler apps for a plane, by situation</h2>

        <h3>Our pick when you didn't prepare: Denny's Maze</h3>
        <p>
          Denny's Maze is our app, so we're obviously not a neutral party here.
        </p>
        <p>
          What our test did show objectively is that the three free mazes worked
          directly after installation without an account, subscription or extra
          content download.
        </p>
        <p>
          That makes Denny useful as a small, zero-prep travel backup rather
          than something you need to configure the night before.
        </p>
        <div class="inline-cta">
          <div>
            <h3>Try Denny's Maze</h3>
            <p>3 mazes free. Works offline. No ads or subscription.</p>
          </div>
          <a class="button" href={dennyProductLink}>Try Denny's Maze →</a>
        </div>

        <h3>Best free option if you prepare ahead: PBS KIDS Games</h3>
        <p>
          PBS KIDS Games is much more generous than Denny in the sheer amount of
          free content available. The catch is preparation.
        </p>
        <p>
          In our test, games had to be downloaded individually while online.
          Once downloaded, those games remained available offline.
        </p>
        <p>
          If you remember to load several games before leaving home, PBS is one
          of the strongest free travel options we tested.
        </p>

        <h3>Best free learning option: Khan Academy Kids</h3>
        <p>
          Khan Academy Kids is free, but it isn't a "download it at the gate and
          forget about Wi-Fi" app.
        </p>
        <p>
          Initial setup required internet in our test. After setup, Khan
          provides a dedicated offline section rather than making the entire
          library available offline.
        </p>
        <p>
          If you're happy to prepare it beforehand, that still gives you useful
          free content for travel.
        </p>

        <h3>Good free mini-library after setup: Sago Mini World</h3>
        <p>
          Sago Mini World surprised us by leaving around four games available in
          our non-subscriber test without requiring us to manually download
          those games first.
        </p>
        <p>
          That's enough to make it useful as another small travel option,
          although most of the larger library sits behind paid access.
        </p>
      </div>
    </section>

    <section class="content-block" aria-labelledby="questions-heading">
      <div class="shell narrow prose">
        <h2 id="questions-heading">Does each toddler app really work offline?</h2>

        <h3>Does PBS KIDS Games work offline?</h3>
        <p>
          Yes, but you need to download the games you want first. In our test,
          downloaded games remained available after we disconnected and reopened
          the app.
        </p>

        <h3>Does Pok Pok work offline?</h3>
        <p>
          Not in the free state we tested. Pok Pok's setup worked without
          internet, but no activities were available without a subscription.
        </p>

        <h3>Does Khan Academy Kids work offline?</h3>
        <p>
          Partially. Initial setup required internet in our test, then a
          dedicated offline section became available.
        </p>

        <h3>Does Lingokids work offline?</h3>
        <p>
          We found no usable offline content in the non-subscriber state we
          tested. A fresh offline launch also remained stuck loading during our
          test.
        </p>

        <h3>Does Sago Mini World work offline?</h3>
        <p>
          Some content did. After online setup, around four games were available
          in our test without subscribing or manually downloading them
          individually.
        </p>
      </div>
    </section>

    <section class="content-block tinted" aria-labelledby="meaning-heading">
      <div class="shell">
        <div class="section-head">
          <h2 id="meaning-heading">"Works offline" can mean very different things</h2>
          <p>
            None of these categories is automatically good or bad. The point is
            knowing what has to happen before internet disappears.
          </p>
        </div>
        <div class="meaning-grid">
          <article>
            <h3>1. Ready immediately</h3>
            <p>
              Useful content is bundled with the app and works after download.
              Example: <a href={dennyProductLink}>Denny's Maze</a> free mazes.
            </p>
          </article>
          <article>
            <h3>2. Online setup first</h3>
            <p>
              The app requires internet during initial setup but offers some
              offline functionality afterward. Example: Khan Academy Kids.
            </p>
          </article>
          <article>
            <h3>3. Download activities first</h3>
            <p>
              The app supports offline content, but parents must manually
              prepare individual games or exercises before leaving Wi-Fi.
              Examples: PBS KIDS Games and Montessori Preschool.
            </p>
          </article>
          <article>
            <h3>4. Payment required</h3>
            <p>
              There is little or no meaningful free offline experience in the
              tested state. Examples: Pok Pok, Thinkrolls, Lingokids, and Bimi
              Boo Learning Games.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="content-block tinted" aria-labelledby="sound-heading">
      <div class="shell">
        <div class="section-head">
          <h2 id="sound-heading">Can you use them without sound?</h2>
          <p>
            This can matter on flights and in shared public places where you
            may not want an iPad making noise.
          </p>
        </div>
        <div class="sound-grid">
          <article>
            <h3>Work well muted</h3>
            <ul>
              <li>Pok Pok</li>
              <li>Thinkrolls</li>
              <li>Sago Mini World</li>
            </ul>
          </article>
          <article>
            <h3>Narration/instructions are part of the experience</h3>
            <p>
              These apps may still be usable muted, but narration or spoken
              instructions may be lost.
            </p>
            <ul>
              <li>Denny's Maze</li>
              <li>Khan Academy Kids</li>
              <li>PBS KIDS Games</li>
              <li>Lingokids</li>
              <li>Montessori Preschool</li>
              <li>Bimi Boo Learning Games</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="content-block" aria-labelledby="non-app-heading">
      <div class="shell narrow prose">
        <h2 id="non-app-heading">Looking for non-app airplane activities too?</h2>
        <p>
          If you're planning the whole flight rather than just the iPad, we've
          also put together the activities that have actually worked for us
          while flying with a young child.
        </p>
        <p>
          Read the broader guide:
          <a href={planeLink}>what actually works on a plane with a
          3-year-old</a>.
        </p>
        <p class="disclosure">
          <strong>Denny's Maze is our own app</strong>, so we've clearly
          labelled it throughout the comparison and used the same testing
          process for it as every other app.
        </p>
        <div class="inline-cta final-cta">
          <div>
            <h3>Try Denny's Maze</h3>
            <p>3 mazes free. Works offline. No ads or subscription.</p>
          </div>
          <a class="button" href={dennyProductLink}>Try Denny's Maze →</a>
        </div>
      </div>
    </section>
  </article>

  <RelatedLinks
    title="More calm travel ideas"
    links={[
      {
        href: lowStimLink,
        title: "Best Low-Stimulation Apps for Toddlers",
        description:
          "A separate scored comparison by brightness, animation, rewards, sound, and travel use."
      },
      {
        href: planeLink,
        title: "What Actually Works on a Plane With a 3 Year Old",
        description:
          "Practical airplane activities tested over repeated toddler flights."
      },
      {
        href: dennyProductLink,
        title: "Denny's Maze",
        description:
          "Our own quiet, offline maze app for toddlers and preschoolers."
      }
    ]}
  />
</BaseLayout>

<style>
  .article-hero {
    padding: clamp(2rem, 5vw, 3.5rem) 0 0.6rem;
  }

  .article-hero .narrow {
    width: min(100%, 68rem);
  }

  .article-hero h1 {
    max-width: 56rem;
    font-size: clamp(2rem, 4vw, 3.45rem);
    line-height: 1.02;
  }

  .lead {
    max-width: 46rem;
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: clamp(1.08rem, 1.6vw, 1.26rem);
    line-height: 1.5;
  }

  .intro-section,
  .comparison-section,
  .method-section,
  .content-block {
