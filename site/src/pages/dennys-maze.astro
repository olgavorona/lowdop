---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";
import { absoluteUrl, buildMeta, organizationSchema, faqSchema } from "../lib/seo";

const appUrl = siteConfig.appStoreUrl;
const subscriptionRemovalLive =
  import.meta.env.PUBLIC_DENNY_NO_SUBSCRIPTIONS === "true";

const title = "Denny’s Maze: Quiet Offline Toddler Game | Harmless Apps";
const description = subscriptionRemovalLive
  ? "Calm, paper-like maze play for toddlers and preschoolers. Works offline with no ads, no subscriptions, no noisy rewards, and simple independent play."
  : "Calm, paper-like maze play for toddlers and preschoolers. Works offline with no ads, no noisy rewards, and simple independent play.";

const meta = buildMeta({
  title,
  description,
  pathname: siteConfig.productPath,
  image: "/images/dennys-maze/maze-ocean.png"
});

const trustItems = [
  ["Works offline", "No Wi-Fi needed"],
  ["No ads", "Ever"],
  subscriptionRemovalLive
    ? ["No subscription", "Unlock once"]
    : ["Free to try", "Start with 3 mazes"],
  ["No timers", "No pressure to keep playing"],
  ["Made for little hands", "Simple, focused interaction"]
];

const useCases = [
  {
    title: "On a flight",
    text: "Works completely offline, so Denny is ready after airplane mode goes on.",
    href: "/blog/what-actually-works-on-a-plane-with-a-3-year-old-after-10-flights/"
  },
  {
    title: "At a restaurant",
    text: "Quiet play with no pieces to drop, crayons to roll away, or public sound required."
  },
  {
    title: "In a waiting room",
    text: "A simple activity you can open when waiting starts to feel very long."
  },
  {
    title: "At home",
    text: "A small, focused activity for quiet time, cooking time, or whenever everyone needs a slower moment."
  }
];

const productFeatures = [
  ["Trace a path", "Guide Denny through each maze with a finger."],
  ["Find the way", "Three difficulty levels give children increasingly challenging paths to solve."],
  [
    "Discover something new",
    "Along the way, Denny meets ocean animals and introduces little facts and stories about marine life."
  ]
];

const calmFeatures = [
  ["No ads or pop-ups", "Nothing interrupts the activity or sends little fingers somewhere unexpected."],
  ["No noisy reward loop", "No flashing celebration after every tap. The maze itself is the activity."],
  ["No timers or pressure", "Children can solve each maze at their own pace."],
  ["A natural stopping point", "Finish a maze, then choose whether to do another. No streak to maintain and no endless feed."]
];

const pricingItems = subscriptionRemovalLive
  ? [
      ["No subscription", "No recurring bill."],
      ["No ads", "Free mazes are ad-free too."],
      ["One-time unlock", "Pay once for full access."]
    ]
  : [
      ["Free to try", "Start with 3 mazes."],
      ["No ads", "Free mazes are ad-free too."],
      ["Full access available", "Unlock more mazes inside the app."]
    ];

const faqs = [
  {
    question: "Does Denny's Maze work without Wi-Fi?",
    answer:
      "Yes. Denny's Maze works completely offline once the app is installed, so it can be used on flights, road trips, and anywhere else without internet access."
  },
  {
    question: "Does Denny's Maze have ads?",
    answer: "No. There are no ads in either the free mazes or the unlocked app."
  },
  ...(subscriptionRemovalLive
    ? [
        {
          question: "Is Denny's Maze a subscription?",
          answer:
            "No. You can try the first 3 mazes for free and unlock the full app with one purchase. There are no recurring subscription charges."
        }
      ]
    : []),
  {
    question: "What age is Denny's Maze for?",
    answer:
      "Denny's Maze is designed for young children and preschoolers. Three difficulty levels let children start with simpler paths and move to more challenging mazes when they're ready."
  },
  {
    question: "Can Denny's Maze be played without sound?",
    answer:
      "Yes. The mazes can be played without sound, which makes Denny useful for planes, restaurants, waiting rooms, and other quiet places."
  },
  {
    question: "Is Denny's Maze a learning app?",
    answer:
      "The main activity is maze solving. While playing, children practice fine-motor control, spatial reasoning, patience, and problem solving, and they can discover little facts about ocean life along the way."
  }
];

const appSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "MobileApplication"],
  name: "Denny's Maze",
  applicationCategory: "EducationalApplication",
  operatingSystem: "iPadOS 16.0 or later",
  isFamilyFriendly: true,
  url: absoluteUrl(siteConfig.productPath),
  downloadUrl: appUrl,
  description:
    "A quiet, offline, paper-like maze activity for toddlers and preschoolers.",
  publisher: {
    "@type": "Organization",
    name: siteConfig.organization.name,
    url: siteConfig.organization.url
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock"
  }
};

const relatedLinks = [
  {
    href: "/offline-toddler-apps/",
    title: "Offline toddler apps tested",
    description:
      "See how Denny's Maze compared with other toddler apps after internet was removed."
  },
  {
    href: "/blog/what-actually-works-on-a-plane-with-a-3-year-old-after-10-flights/",
    title: "What Actually Works on a Plane With a 3-Year-Old",
    description:
      "Practical airplane activities that last longer because each one gives a child a simple job."
  },
  {
    href: "/best-low-stimulation-apps-for-toddlers/",
    title: "Best Low-Stimulation Apps for Toddlers",
    description:
      "A parent-friendly comparison of calmer apps by pace, sound, interruptions, and independence."
  }
];
---

<BaseLayout
  {...meta}
  ogTitle="Denny’s Maze: Quiet Offline Maze Play for Toddlers"
  ogDescription="A paper-like iPad maze activity for quiet moments. Works offline, with no ads, timers, or noisy rewards."
  schemas={[organizationSchema(), appSchema, faqSchema(faqs)]}
>
  <section class="dm-hero" id="top">
    <div class="dm-shell dm-hero-grid">
      <div class="dm-hero-copy">
        <p class="eyebrow">Denny's Maze for iPad</p>
        <h1>Quiet, offline maze play for toddlers</h1>
        <p class="dm-lead">
          A calm, paper-like activity for little hands. Guide Denny through
          hand-drawn mazes without ads, {subscriptionRemovalLive ? "subscriptions, " : ""}noisy rewards,
          or distracting pop-ups.
        </p>
        <div class="dm-actions">
          <a
            class="button"
            href={appUrl}
            data-app-store-cta="hero"
          >
            Try Denny's Maze Free
          </a>
        </div>
        <p class="dm-microcopy">
          3 mazes free · {subscriptionRemovalLive ? "One-time unlock · " : ""}Works offline
        </p>
      </div>

      <figure class="dm-hero-shot">
        <img
          src="/images/dennys-maze/maze-ocean.png"
          alt="Denny's Maze offline toddler maze game on iPad"
          width="2420"
          height="1668"
          loading="eager"
        />
        <img class="dm-denny" src="/images/denny.png" alt="" width="512" height="512" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="dm-trust" aria-label="Denny's Maze parent benefits">
    <div class="dm-shell dm-trust-grid">
      {trustItems.map(([title, text]) => (
        <div class="dm-trust-item">
          <h2>{title}</h2>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="dm-section" id="quiet-minutes">
    <div class="dm-shell">
      <div class="dm-section-head">
        <p class="eyebrow">Quiet toddler activity</p>
        <h2>For the moments when you need a few quiet minutes</h2>
        <p>
          Denny's Maze is made for the in-between moments: when your child needs
          something to do, but you don't want another loud, frantic kids game.
        </p>
      </div>
      <div class="dm-cards">
        {useCases.map((item) => (
          item.href ? (
            <a class="dm-card" href={item.href}>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </a>
          ) : (
            <article class="dm-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="dm-section dm-split-section" id="maze-book">
    <div class="dm-shell dm-split">
      <div>
        <p class="eyebrow">Paper-like maze play</p>
        <h2>Like a maze book on an iPad</h2>
        <p>
          Denny's Maze is intentionally closer to a paper activity book than a
          typical kids game. Children guide Denny the crab through illustrated
          mazes, solve one little challenge at a time, and move on when they're
          ready.
        </p>
        <div class="dm-feature-list">
          {productFeatures.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="dm-ipad-gallery" aria-label="Denny's Maze iPad screenshots">
        <figure class="dm-ipad-frame">
          <img
            src="/images/dennys-maze/maze-space.png"
            alt="Denny's Maze space maze activity on an iPad"
            width="2420"
            height="1668"
            loading="lazy"
          />
        </figure>
        <figure class="dm-ipad-frame">
          <img
            src="/images/dennys-maze/maze-library.png"
            alt="Denny's Maze maze library and difficulty selection on an iPad"
            width="2420"
            height="1668"
            loading="lazy"
          />
        </figure>
        <figure class="dm-ipad-frame">
          <img
            src="/images/dennys-maze/maze-ocean.png"
            alt="Denny's Maze ocean maze activity on an iPad"
            width="2420"
            height="1668"
            loading="lazy"
          />
        </figure>
        <figure class="dm-ipad-frame">
          <img
            src="/images/dennys-maze/maze-finish.png"
            alt="Denny's Maze ocean fact and maze completion screen on an iPad"
            width="2360"
            height="1640"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="dm-section dm-calm" id="calm-design">
    <div class="dm-shell dm-split">
      <div>
        <p class="eyebrow">Low-stimulation design</p>
        <h2>Calm by design</h2>
        <p>
          Many children's games are built around keeping attention for as long
          as possible. Denny's Maze takes a different approach.
        </p>
      </div>
      <div class="dm-calm-list">
        {calmFeatures.map(([title, text]) => (
          <article>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
        <p class="dm-closing">
          That's what we mean by low-stimulation play: not less interesting,
          just less demanding of your child's attention.
        </p>
      </div>
    </div>
  </section>

  <section class="dm-section" id="independent-use">
    <div class="dm-shell dm-independent">
      <div>
        <p class="eyebrow">Simple interaction</p>
        <h2>Made for independent little hands</h2>
        <p>
          A kids app isn't very helpful if your child needs you every two
          minutes. Denny's Maze keeps the interaction deliberately simple, so
          young children can focus on the maze instead of navigating complicated
          menus, ads, or pop-ups.
        </p>
      </div>
      <figure class="dm-sequence">
        <div class="dm-sequence-steps" aria-label="Open, choose, trace, finish">
          <span>Open</span>
          <span>Choose</span>
          <span>Trace</span>
          <span>Finish</span>
        </div>
        <img
          src="/images/dennys-maze/maze-library.png"
          alt="Denny's Maze quiet maze activity on an iPad"
          width="2420"
          height="1668"
          loading="lazy"
        />
        <figcaption>Open. Choose. Trace. Finish.</figcaption>
      </figure>
    </div>
  </section>

  <section class="dm-section dm-offline" id="offline">
    <div class="dm-shell dm-offline-box">
      <p class="eyebrow">Offline toddler game</p>
      <h2>Ready for airplane mode</h2>
      <p>
        Denny's Maze works completely offline. Once it's on your iPad, your
        child can keep playing without Wi-Fi or mobile data.
      </p>
      <strong>No Wi-Fi. No pre-flight entertainment panic.</strong>
      <p>Download Denny before you leave, and the mazes are there when you need them.</p>
    </div>
  </section>

  <section class="dm-section" id="pricing">
    <div class="dm-shell dm-pricing">
      <div>
        <p class="eyebrow">App Store</p>
        <h2>{subscriptionRemovalLive ? "Try it free. Unlock it once." : "Try it free. Unlock more when ready."}</h2>
        <p>
          Start with 3 mazes for free. If Denny works for your child,
          {subscriptionRemovalLive
            ? " unlock the full app with one purchase."
            : " continue with more maze play inside the app."}
        </p>
      </div>
      <div class="dm-pricing-card">
        {pricingItems.map(([title, text]) => (
          <article>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
        <a class="button" href={appUrl} data-app-store-cta="pricing">
          Try Denny's Maze Free
        </a>
        <p class="dm-microcopy">Available on the App Store for iPad</p>
      </div>
    </div>
  </section>

  <section class="dm-section dm-founder" id="founder">
    <div class="dm-shell dm-split">
      <div>
        <p class="eyebrow">From the creator</p>
        <h2>Made by a parent who wanted something calmer</h2>
      </div>
      <div class="dm-letter">
        <p>
          I originally made Denny's Maze for my own child. I wanted an iPad
          activity that felt more like handing over a maze book than starting
          another noisy kids game.
        </p>
        <p>
          Something we could use on a flight, while waiting, or during a quiet
          moment at home. Something with a beginning and an end, without ads,
          flashing rewards, or an endless stream of "one more" content.
        </p>
        <p>Denny grew from that idea.</p>
        <div class="dm-signature">
          <strong>Olga</strong>
          <span>Creator of Harmless Apps</span>
        </div>
      </div>
    </div>
  </section>

  <section class="dm-section" id="faq">
    <div class="dm-shell dm-split">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2>Questions parents ask before downloading</h2>
      </div>
      <div class="dm-faq-list">
        {faqs.map((item) => (
          <details class="dm-faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="dm-section" id="related">
    <div class="dm-shell">
      <div class="dm-section-head">
        <p class="eyebrow">More quiet ideas</p>
        <h2>More ideas for calmer travel with kids</h2>
      </div>
      <div class="dm-cards dm-related-cards">
        {relatedLinks.map((link) => (
          <a class="dm-card" href={link.href}>
            <h3>{link.title}</h3>
            <p>{link.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="dm-final">
    <div class="dm-shell">
      <h2>Try the first maze free.</h2>
      <p>A quiet, offline maze activity for flights, restaurants, waiting rooms, road trips, and home.</p>
      <a class="button" href={appUrl} data-app-store-cta="final">
        Try Denny's Maze Free
      </a>
    </div>
  </section>

  <script is:inline>
    (() => {
      document.querySelectorAll("[data-app-store-cta]").forEach((link) => {
        link.addEventListener("click", () => {
          const location = link.getAttribute("data-app-store-cta") || "unknown";
          window.va?.("event", {
            name: "dennys_maze_app_store_click",
            data: { location }
          });
        });
      });
    })();
  </script>
</BaseLayout>

<style>
  .dm-shell {
    width: min(calc(100% - 2rem), var(--shell));
    margin: 0 auto;
  }

  .dm-hero {
    padding: clamp(3.5rem, 8vw, 6rem) 0 clamp(2.5rem, 6vw, 4.5rem);
  }

  .dm-hero-grid,
  .dm-split,
  .dm-independent,
  .dm-pricing {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .dm-hero-copy {
    max-width: 36rem;
  }

  .dm-lead {
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.5;
  }

  .dm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.7rem;
  }

  .dm-microcopy {
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .dm-hero-shot {
    position: relative;
    margin: 0;
    justify-self: end;
    width: min(100%, 32rem);
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 1.7rem;
    background: var(--bg-deep);
    box-shadow: var(--shadow);
  }

  .dm-hero-shot > img:first-child {
    width: 100%;
    aspect-ratio: 2420 / 1668;
    max-height: 22rem;
    object-fit: cover;
    object-position: center;
    border-radius: 1.1rem;
    border: 1px solid var(--line-faint);
  }

  .dm-denny {
    position: absolute;
    width: clamp(4.5rem, 10vw, 7rem);
    height: auto;
    right: -0.8rem;
    bottom: -1rem;
    filter: drop-shadow(0 14px 22px rgba(40, 32, 14, 0.14));
  }

  .dm-trust {
    border-top: 1px dashed var(--line);
    border-bottom: 1px dashed var(--line);
    background: rgba(253, 247, 238, 0.32);
  }

  .dm-trust-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  .dm-trust-item {
    padding: 1.2rem 1rem 1.25rem;
    border-right: 1px dashed var(--line);
  }

  .dm-trust-item:first-child {
    border-left: 1px dashed var(--line);
  }

  .dm-trust-item h2 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
    letter-spacing: 0;
  }

  .dm-trust-item p,
  .dm-card p,
  .dm-feature-list p,
  .dm-calm-list p,
  .dm-pricing-card p,
  .dm-faq-item p {
    margin: 0;
    color: var(--muted);
  }

  .dm-section {
    padding: clamp(3.75rem, 8vw, 6rem) 0;
    border-bottom: 1px dashed var(--line);
  }

  .dm-section-head {
    max-width: 46rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .dm-section-head p:not(.eyebrow),
  .dm-split p:not(.eyebrow),
  .dm-independent p,
  .dm-offline-box p,
  .dm-pricing > div > p,
  .dm-final p {
    color: var(--muted);
    font-size: 1.08rem;
  }

  .dm-cards,
  .dm-feature-list,
  .dm-calm-list,
  .dm-pricing-card {
    display: grid;
    gap: 1rem;
  }

  .dm-cards {
    grid-template-columns: repeat(4, 1fr);
  }

  .dm-card,
  .dm-feature-list article,
  .dm-calm-list article,
  .dm-pricing-card,
  .dm-faq-item {
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  a.dm-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  a.dm-card:hover {
    background: var(--bg-deep);
  }

  .dm-card h3,
  .dm-feature-list h3,
  .dm-calm-list h3,
  .dm-pricing-card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.25rem;
    letter-spacing: 0;
  }

  .dm-feature-list {
    margin-top: 1.5rem;
  }

  .dm-ipad-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    align-items: start;
  }

  .dm-ipad-frame {
    margin: 0;
    aspect-ratio: 2420 / 1668;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-deep);
    box-shadow: 0 16px 36px rgba(40, 32, 14, 0.08);
  }

  .dm-ipad-frame img,
  .dm-sequence img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .dm-calm {
    background: rgba(94, 125, 134, 0.08);
  }

  .dm-closing {
    padding: 0.2rem 0 0;
    font-style: italic;
  }

  .dm-sequence {
    margin: 0;
  }

  .dm-sequence-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-bottom: 0.8rem;
  }

  .dm-sequence-steps span {
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-deep);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
  }

  .dm-sequence img {
    aspect-ratio: 2420 / 1668;
    max-height: 22rem;
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-deep);
    box-shadow: 0 16px 36px rgba(40, 32, 14, 0.08);
  }

  .dm-sequence figcaption {
    margin-top: 0.65rem;
    color: var(--muted);
    text-align: center;
    font-style: italic;
  }

  .dm-offline-box {
    padding: clamp(1.5rem, 5vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-deep);
  }

  .dm-offline-box strong {
    display: block;
    margin: 1.1rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    line-height: 1.1;
  }

  .dm-pricing-card {
    background: var(--bg-deep);
  }

  .dm-pricing-card article {
    padding-bottom: 0.9rem;
    border-bottom: 1px dashed var(--line);
  }

  .dm-pricing-card .button {
    margin-top: 0.5rem;
    width: fit-content;
  }

  .dm-founder {
    background: rgba(253, 247, 238, 0.42);
  }

  .dm-letter {
    font-size: 1.18rem;
  }

  .dm-letter p + p {
    margin-top: 1rem;
  }

  .dm-signature {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    align-items: baseline;
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .dm-signature strong {
    color: var(--text);
  }

  .dm-faq-list {
    display: grid;
    gap: 0.8rem;
  }

