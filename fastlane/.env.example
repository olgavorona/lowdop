# Create an App Store Connect API key with access to this app.
# Keep the downloaded .p8 outside the repository.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8

# Optional; when omitted, the uploader finds this from the bundle identifier.
# ASC_APP_ID=
