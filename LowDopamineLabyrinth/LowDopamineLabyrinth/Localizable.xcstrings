          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La narración de audio utilizada por la aplicación viene incluida en ella. La aplicación no graba tu voz ni recopila audio de tu dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本アプリの音声ナレーションはアプリに同梱されています。音声を録音したり、端末から音声データを収集したりしません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用使用的语音旁白随应用提供。应用不会录制您的声音，也不会收集设备上的音频。"
          }
