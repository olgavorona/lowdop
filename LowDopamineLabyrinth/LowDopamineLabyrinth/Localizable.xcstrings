        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el contenido de la aplicación, incluidos personajes, historias, ilustraciones, narraciones de audio y diseños de laberintos, pertenece a Low Dopamine Labyrinth y está protegido por derechos de autor. No puedes reproducir, distribuir ni crear obras derivadas de su contenido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャラクター、物語、イラスト、音声ナレーション、迷路のデザインを含む本アプリのすべてのコンテンツはLow Dopamine Labyrinthに帰属し、著作権で保護されています。コンテンツの複製、配布、二次的著作物の作成は禁止されています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用中的所有内容，包括角色、故事、插图、语音旁白和迷宫设计，均归 Low Dopamine Labyrinth 所有，并受版权保护。未经许可，您不得复制、传播或基于应用内容创作衍生作品。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캐릭터, 이야기, 그림, 음성 해설, 미로 디자인 등 앱의 모든 콘텐츠는 Low Dopamine Labyrinth의 소유이며 저작권법의 보호를 받습니다. 앱의 콘텐츠를 복제하거나 배포하거나 이를 바탕으로 2차 저작물을 만들 수 없습니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جميع محتويات التطبيق، بما فيها الشخصيات والقصص والرسومات والسرد الصوتي وتصاميم المتاهات، مملوكة لـ Low Dopamine Labyrinth ومحمية بحقوق النشر. لا يجوز نسخ محتوى التطبيق أو توزيعه أو إنشاء أعمال مشتقة منه."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt innehåll i appen, inklusive figurer, berättelser, illustrationer, berättarröst och labyrintutformning, ägs av Low Dopamine Labyrinth och skyddas av upphovsrätt. Du får inte kopiera, sprida eller skapa bearbetningar av appens innehåll."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki sovelluksen sisältö, kuten hahmot, tarinat, kuvitus, äänikerronta ja sokkeloiden toteutus, on Low Dopamine Labyrinthin omaisuutta ja tekijänoikeuden suojaamaa. Sovelluksen sisältöä ei saa jäljentää, levittää eikä käyttää muunnelmien luomiseen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle inhoud van de app, waaronder personages, verhalen, illustraties, gesproken tekst en doolhofontwerpen, is eigendom van Low Dopamine Labyrinth en wordt beschermd door het auteursrecht. Je mag de inhoud van de app niet verveelvoudigen, verspreiden of bewerken."
          }
        }
      }
    },
