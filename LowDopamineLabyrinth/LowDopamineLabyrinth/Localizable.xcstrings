          }
        }
      }
    },
    "We do not use device identifiers for tracking" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verwenden keine Gerätekennungen zum Tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No utilizamos identificadores del dispositivo para el seguimiento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追跡のためにデバイス識別子を使用しません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备标识符不会用于跟踪"
          }
        }
      }
    },
    "We may update these Terms from time to time. Continued use of the App after changes constitutes acceptance of the updated Terms." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir können diese Bedingungen von Zeit zu Zeit aktualisieren. Wenn du die App nach einer Änderung weiter nutzt, gilt dies als Zustimmung zu den aktualisierten Bedingungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podemos actualizar estas Condiciones ocasionalmente. El uso continuado de la aplicación después de los cambios implica la aceptación de las Condiciones actualizadas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本規約は随時更新される場合があります。変更後も本アプリを利用し続けることで、更新後の規約に同意したものとみなされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们可能不时更新本条款。条款变更后继续使用本应用，即表示您接受更新后的条款。"
          }
        }
      }
    },
    "We use TelemetryDeck to collect anonymous usage statistics, such as onboarding steps, gameplay events, difficulty selection, and which paywall entry point was used. We use this information to understand which parts of the App are helpful and which need improvement." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verwenden TelemetryDeck, um anonyme Nutzungsstatistiken zu erfassen, beispielsweise zu Einführungsschritten, Spielaktionen, der Wahl des Schwierigkeitsgrads und dazu, über welchen Einstieg die Kaufseite geöffnet wurde. So erkennen wir, welche Bereiche der App hilfreich sind und wo wir sie verbessern können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizamos TelemetryDeck para recopilar estadísticas de uso anónimas, como los pasos de introducción, los eventos del juego, la selección de dificultad y el punto desde el que se accedió a la pantalla de compra. Esta información nos ayuda a saber qué partes de la aplicación son útiles y cuáles necesitan mejoras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TelemetryDeckを使用し、初期設定の手順、プレイ中の操作、難易度の選択、購入画面へのアクセス経路などの匿名利用統計を収集します。これらの情報は、アプリの有用性や改善点の把握に使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们使用 TelemetryDeck 收集匿名使用统计信息，例如初始设置步骤、游戏操作、难度选择，以及用户从哪个入口进入付费页面。我们利用这些信息了解应用的哪些功能有帮助，以及哪些方面需要改进。"
          }
        }
      }
    },
