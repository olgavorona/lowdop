    "%lld" : {
      "comment" : "A label inside a circle that shows the order of a cue in the first stroke of a magic trick. The text inside the circle is the order number of the cue.",
      "isCommentAutoGenerated" : true
    },
    "%lld / %lld" : {
      "comment" : "A label showing the current labyrinth index and the total number of labyrinths. The first argument is the 1-based index of the current labyrinth. The second argument is the total number of labyrinths.",
