    "If we make changes to this policy, we will update the date at the top and notify users through an App update." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls wir diese Richtlinie ändern, aktualisieren wir das Datum oben und informieren die Nutzer durch ein App-Update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si modificamos esta política, actualizaremos la fecha indicada arriba e informaremos a los usuarios mediante una actualización de la aplicación."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本ポリシーを変更する場合は、冒頭の日付を更新し、アプリのアップデートを通じてお知らせします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果本政策有变更，我们会更新顶部的日期，并通过应用更新通知用户。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 방침이 변경되면 상단의 날짜를 수정하고 앱 업데이트를 통해 사용자에게 알립니다."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا أجرينا تغييرات على هذه السياسة، فسنحدّث التاريخ في أعلاها ونُبلغ المستخدمين من خلال تحديث للتطبيق."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om vi ändrar denna policy uppdaterar vi datumet överst och meddelar användarna genom en appuppdatering."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos muutamme tätä käytäntöä, päivitämme yläreunan päivämäärän ja ilmoitamme käyttäjille sovelluspäivityksen kautta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als we dit beleid wijzigen, werken we de datum bovenaan bij en informeren we gebruikers via een app-update."
          }
        }
      }
    },
