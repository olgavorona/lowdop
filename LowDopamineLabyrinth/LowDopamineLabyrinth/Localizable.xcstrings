    "We do not collect any personal information from children or adults. Specifically:" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erheben keine personenbezogenen Daten von Kindern oder Erwachsenen. Das bedeutet insbesondere:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recopilamos información personal de niños ni adultos. En concreto:"
          }
        }
      }
    },
    "We do not collect location data" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erfassen keine Standortdaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recopilamos datos de ubicación."
          }
        }
      }
    },
    "We do not collect names, email addresses, phone numbers, or physical addresses" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erfassen keine Namen, E-Mail-Adressen, Telefonnummern oder Postanschriften."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recopilamos nombres, direcciones de correo electrónico, números de teléfono ni direcciones postales."
          }
        }
      }
    },
    "We do not collect photos, videos, or audio recordings" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erfassen keine Fotos, Videos oder Audioaufnahmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recopilamos fotos, vídeos ni grabaciones de audio."
          }
        }
      }
    },
    "We do not sell personal data and we do not share personal information for advertising. Limited app activity data is sent to TelemetryDeck for anonymous analytics, and purchase-related information is processed by Apple when you use in-app purchases." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verkaufen keine personenbezogenen Daten und geben keine persönlichen Informationen für Werbezwecke weiter. Begrenzte Daten zu App-Aktivitäten werden für anonyme Analysen an TelemetryDeck gesendet. Informationen zu Käufen werden von Apple verarbeitet, wenn du In-App-Käufe nutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No vendemos datos personales ni compartimos información personal con fines publicitarios. Enviamos datos limitados de actividad de la aplicación a TelemetryDeck para análisis anónimos, y Apple procesa la información relacionada con las compras cuando utilizas compras dentro de la aplicación."
          }
        }
      }
    },
    "We do not send names, email addresses, photos, recordings, contacts, or precise location through analytics. Learn more at telemetrydeck.com." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir übermitteln keine Namen, E-Mail-Adressen, Fotos, Aufnahmen, Kontakte oder genauen Standortdaten an den Analysedienst. Mehr dazu auf telemetrydeck.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No enviamos nombres, correos electrónicos, fotos, grabaciones, contactos ni ubicaciones precisas mediante los análisis. Más información en telemetrydeck.com."
          }
        }
      }
    },
    "We do not use cookies or similar technologies" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verwenden keine Cookies oder vergleichbare Technologien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No usamos cookies ni tecnologías similares."
          }
        }
      }
    },
    "We do not use device identifiers for tracking" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verwenden keine Gerätekennungen zum Tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No utilizamos identificadores del dispositivo para el seguimiento."
          }
        }
      }
    },
    "We may update these Terms from time to time. Continued use of the App after changes constitutes acceptance of the updated Terms." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir können diese Bedingungen von Zeit zu Zeit aktualisieren. Wenn du die App nach einer Änderung weiter nutzt, gilt dies als Zustimmung zu den aktualisierten Bedingungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podemos actualizar estas Condiciones ocasionalmente. El uso continuado de la aplicación después de los cambios implica la aceptación de las Condiciones actualizadas."
          }
        }
      }
    },
    "We use TelemetryDeck to collect anonymous usage statistics, such as onboarding steps, gameplay events, difficulty selection, and which paywall entry point was used. We use this information to understand which parts of the App are helpful and which need improvement." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verwenden TelemetryDeck, um anonyme Nutzungsstatistiken zu erfassen, beispielsweise zu Einführungsschritten, Spielaktionen, der Wahl des Schwierigkeitsgrads und dazu, über welchen Einstieg die Kaufseite geöffnet wurde. So erkennen wir, welche Bereiche der App hilfreich sind und wo wir sie verbessern können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizamos TelemetryDeck para recopilar estadísticas de uso anónimas, como los pasos de introducción, los eventos del juego, la selección de dificultad y el punto desde el que se accedió a la pantalla de compra. Esta información nos ayuda a saber qué partes de la aplicación son útiles y cuáles necesitan mejoras."
          }
        }
      }
    },
