          }
        }
      }
    },
    "We do not collect names, email addresses, phone numbers, or physical addresses" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erfassen keine Namen, E-Mail-Adressen, Telefonnummern oder Postanschriften."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recopilamos nombres, direcciones de correo electrónico, números de teléfono ni direcciones postales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "氏名、メールアドレス、電話番号、住所は収集しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们不收集姓名、电子邮箱、电话号码或住址。"
          }
        }
      }
    },
    "We do not collect photos, videos, or audio recordings" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erfassen keine Fotos, Videos oder Audioaufnahmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No recopilamos fotos, vídeos ni grabaciones de audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真、動画、音声録音は収集しません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们不收集照片、视频或录音"
          }
        }
      }
    },
    "We do not sell personal data and we do not share personal information for advertising. Limited app activity data is sent to TelemetryDeck for anonymous analytics, and purchase-related information is processed by Apple when you use in-app purchases." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verkaufen keine personenbezogenen Daten und geben keine persönlichen Informationen für Werbezwecke weiter. Begrenzte Daten zu App-Aktivitäten werden für anonyme Analysen an TelemetryDeck gesendet. Informationen zu Käufen werden von Apple verarbeitet, wenn du In-App-Käufe nutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No vendemos datos personales ni compartimos información personal con fines publicitarios. Enviamos datos limitados de actividad de la aplicación a TelemetryDeck para análisis anónimos, y Apple procesa la información relacionada con las compras cuando utilizas compras dentro de la aplicación."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人データを販売したり、広告目的で個人情報を共有したりしません。限定的なアプリ利用データは匿名解析のためTelemetryDeckに送信され、アプリ内購入に関する情報はAppleが処理します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们不会出售个人数据，也不会为广告目的共享个人信息。有限的应用使用数据会发送至 TelemetryDeck 进行匿名分析；使用应用内购买时，购买相关信息由 Apple 处理。"
          }
        }
      }
    },
    "We do not send names, email addresses, photos, recordings, contacts, or precise location through analytics. Learn more at telemetrydeck.com." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir übermitteln keine Namen, E-Mail-Adressen, Fotos, Aufnahmen, Kontakte oder genauen Standortdaten an den Analysedienst. Mehr dazu auf telemetrydeck.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No enviamos nombres, correos electrónicos, fotos, grabaciones, contactos ni ubicaciones precisas mediante los análisis. Más información en telemetrydeck.com."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解析サービスを通じて氏名、メールアドレス、写真、録音、連絡先、正確な位置情報を送信することはありません。詳しくは telemetrydeck.com をご覧ください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们不会通过分析服务发送姓名、邮箱、照片、录音、联系人或精确位置。详情请访问 telemetrydeck.com。"
          }
        }
      }
    },
    "We do not use cookies or similar technologies" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verwenden keine Cookies oder vergleichbare Technologien."
          }
        },
        "es" : {
          "stringUnit" : {
